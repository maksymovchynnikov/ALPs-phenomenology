                    RowBox[{"I", "*", RowBox[{"PmatrixALP", "[", "x", "]"}]}]}]}], ";"}],
              "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"\[CapitalPhi]matrixHC", "[", "x_",
                    "]"}], "=", RowBox[{RowBox[{"SheavyMatrixCondensate", "[", "x", "]"}], "-",
