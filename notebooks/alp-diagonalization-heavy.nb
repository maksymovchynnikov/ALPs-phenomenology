        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"(*", RowBox[{"The", " ", "\[Beta]", " ",
                   RowBox[{"term", ":", " ", RowBox[{"from", " ", "chiral", " ", "rotation", " ",
                       "to", " ", "eliminate", " ", "the", " ", "gluon", " ", "coupling"}]}]}],
                 "*)"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"PheavyMatrixALP", "[",
                     "x_", "]"}], "=", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                            {RowBox[{"\[Alpha]", "=", FractionBox["2", "f\[Pi]"]}], ",", RowBox[
                              {"\[Beta]", "=", RowBox[{"ChiralRotationCoefficient", "*", RowBox[
                                 {"alp", "[", "x", "]"}]}]}]}], "}"}], ",", RowBox[{FractionBox[
                            "1", "\[Alpha]"], RowBox[{"(", RowBox[{RowBox[{"\[Alpha]", "*",
                                 RowBox[{"PheavyMatrix", "[", "x", "]"}]}], "-", RowBox[{"2", "*",
                                 "\[Beta]"}]}], ")"}]}]}], "]"}], "//", "Simplify"}]}],
                 "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"PheavyMatrixALPHC", "[", "x_",
                       "]"}], "=", RowBox[{"ConjugateTranspose", "[", RowBox[{"PheavyMatrixALP",
                         "[", "x", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
                 RowBox[{RowBox[{RowBox[{"dPheavyMatrixALP", "[", RowBox[{"x_", ",", "\[Mu]_"}],
                       "]"}], "=", RowBox[{RowBox[{"D", "[", RowBox[{RowBox[{"PheavyMatrixALP",
                             "[", "x", "]"}], ",", "x"}], "]"}], "/.", RowBox[{"Evaluate", "[",
                         RowBox[{"DerivativesReplacementRulePS", "[", "\[Mu]", "]"}], "]"}]}]}],
                   ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"dPheavyMatrixALPHC", "[",
                       RowBox[{"x_", ",", "\[Mu]_"}], "]"}], "=", RowBox[{"ConjugateTranspose",
                       "[", RowBox[{"PheavyMatrixALP", "[", RowBox[{"x", ",", "\[Mu]"}], "]"}],
                       "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"The", " ",
                     "additional", " ", SubscriptBox["c", "q"], " ", RowBox[{"term", ":", " ",
                       RowBox[{"to", " ", "replace", " ", "instances", " ", "P", " ", "when", " ",
                         "the", " ", "underlying", " ", "interaction", " ", "is", " ", "written",
                         " ", "in", " ", "terms", " ", "of", " ", "the", " ", "derivative", " ",
                         SubscriptBox["d", "\[Mu]"], "\[CapitalSigma]", " ", "or", " ", "other",
                         " ", "related", " ", RowBox[{"objects", ".", " ", "Not"}], " ",
                         RowBox[{"always", "!"}]}]}]}], "*)"}], "\[IndentingNewLine]",
                 RowBox[{RowBox[{RowBox[{"PheavyMatrixALPcqCovariant", "[", "x_", "]"}], "=",
                     RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"\[Alpha]",
                                 "=", FractionBox[RowBox[{"2", "*", "I"}], "f\[Pi]"]}], ",",
                               RowBox[{"\[Beta]", "=", RowBox[{"ChiralRotationCoefficient", "*",
                                 RowBox[{"alp", "[", "x", "]"}]}]}]}], "}"}], ",", RowBox[
                            {RowBox[{FractionBox["1", "\[Alpha]"], RowBox[{"(", RowBox[{RowBox[
                                 {"\[Alpha]", "*", RowBox[{"PheavyMatrix", "[", "x", "]"}]}], "-",
                                 RowBox[{"(", RowBox[{"2", "*", "\[Beta]"}], RowBox[{"(*", RowBox[
                                 {RowBox[{"+", "I"}], "*", "\[Alpha]", "*", RowBox[{"(", RowBox[
                                 {RowBox[{RowBox[{"Pmatrix", "[", "x", "]"}], ".", "\[Beta]"}],
                                 "+", RowBox[{"\[Beta]", ".", RowBox[{"Pmatrix", "[", "x",
                                 "]"}]}]}], ")"}]}], "*)"}], ")"}]}], ")"}]}], "+", RowBox[
                              {FractionBox["f\[Pi]", "I"], "*", "cqMatrixCovariantDerivative", "*",
                               RowBox[{"alp", "[", "x", "]"}]}]}]}], "]"}], "//", "Simplify"}]}],
                   ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[
                      {"PheavyMatrixALPcqCovariantHC", "[", "x_", "]"}], "=", RowBox[
                      {"ConjugateTranspose", "[", RowBox[{"PheavyMatrixALPcqCovariant", "[", "x",
                         "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[
                  {RowBox[{RowBox[{"dPheavyMatrixALPcqCovariant", "[", RowBox[{"x_", ",",
                         "\[Mu]_"}], "]"}], "=", RowBox[{RowBox[{"D", "[", RowBox[{RowBox[
                            {"PheavyMatrixALPcqCovariant", "[", "x", "]"}], ",", "x"}], "]"}],
