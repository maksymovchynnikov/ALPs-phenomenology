                        {"dPheavyMatrixALPcqCovariant", "[", RowBox[{"x", ",", "\[Mu]"}], "]"}],
                       "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"The", " ",
