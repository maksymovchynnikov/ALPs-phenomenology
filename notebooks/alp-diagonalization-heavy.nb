                               {"\[CapitalPhi]matrix", "[", "x", "]"}], ".", RowBox[
                               {"PheavyMatrixALPHC", "[", "x", "]"}], ".", RowBox[
                               {"\[CapitalPhi]matrixHC", "[", "x", "]"}]}], "+", RowBox[
                             {RowBox[{"\[CapitalPhi]matrixHC", "[", "x", "]"}], ".", RowBox[
                               {"PheavyMatrixALP", "[", "x", "]"}], ".", RowBox[
                               {"\[CapitalPhi]matrixHC", "[", "x", "]"}], ".", RowBox[
                               {"PheavyMatrixALP", "[", "x", "]"}]}]}], "]"}]}], "+",
                      RowBox[{"Tr", "[", RowBox[{RowBox[{RowBox[{"PheavyMatrixALPHC", "[", "x",
                              "]"}], ".", RowBox[{"PheavyMatrixALP", "[", "x", "]"}], ".",
                            "E1matrix"}], "+", RowBox[{RowBox[{"PheavyMatrixALP", "[", "x", "]"}],
                            ".", RowBox[{"PheavyMatrixALPHC", "[", "x", "]"}], ".", "E1matrix"}]}],
                        "]"}]}], "//", "Expand"}]}], ";"}], "\[IndentingNewLine]",
              RowBox[{RowBox[{"LPheavyALPnonDerivatives", "=", RowBox[{RowBox[{"(", RowBox[
