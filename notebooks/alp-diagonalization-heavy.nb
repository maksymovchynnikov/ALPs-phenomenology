                               RowBox[{"\"a\"", ",", "\"\[Eta](1295)\""}], "]"}]}]}], ",",
                         RowBox[{"ALP\[Eta]1440", "->", RowBox[{RowBox[{"-", FractionBox["1",
                                "\[Epsilon]"]}], RowBox[{"m0HeavyaTransformationCoefficients", "[",
                               RowBox[{"\"a\"", ",", "\"\[Eta](1440)\""}], "]"}]}]}], ",",
                         RowBox[{"\[Pi]01300ALP", "->", RowBox[{FractionBox["1", "\[Epsilon]"],
                             RowBox[{"m0HeavyaTransformationCoefficients", "[", RowBox[
                                {"\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)(1300)\"", ",",
                                 "\"a\""}], "]"}]}]}], ",", RowBox[{"\[Eta]1295ALP", "->",
                           RowBox[{FractionBox["1", "\[Epsilon]"], RowBox[
