          {Cell["Rules for replacing symbolic transformations with explicit expressions",
            "Subsection", ExpressionUUID -> "cc03d136-b3b2-1544-9cab-92f4239fe5a7"],
           Cell[CellGroupData[{Cell[BoxData[{RowBox[{"Do", "[", "\[IndentingNewLine]",
                   RowBox[{RowBox[{RowBox[{"m0HeavyaTransformationCoefficients", "[", RowBox[
                          {"p1", ",", "p2"}], "]"}], "=", RowBox[{"D", "[", RowBox[
                          {RowBox[{"m0HeavyaTransformation", "[", RowBox[{"p1", ",", "x"}], "]"}],
                           ",", RowBox[{"If", "[", RowBox[{RowBox[{"p2", "==", "\"a\""}], ",",
                               RowBox[{"alp", "[", "x", "]"}], ",", RowBox[{"PheavyFieldSymbol",
                                 "[", RowBox[{"p2", ",", "x"}], "]"}]}], "]"}]}], "]"}]}],
                     "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"p1", ",",
                         "listMesonP0heavya"}], "}"}], ",", RowBox[{"{", RowBox[{"p2", ",",
                         "listMesonP0heavya"}], "}"}]}], "]"}], "\[IndentingNewLine]",
                 RowBox[{"rulem0HeavyaTransformationSymbolicToExplicit", "=", RowBox[
                    {RowBox[{"{", RowBox[{RowBox[{"ALP\[Pi]01300", "->", RowBox[{RowBox[{"-",
                               FractionBox["1", "\[Epsilon]"]}], RowBox[
                              {"m0HeavyaTransformationCoefficients", "[", RowBox[{"\"a\"", ",",
                                 "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)(1300)\""}], "]"}]}]}],
                         ",", RowBox[{"ALP\[Eta]1295", "->", RowBox[{RowBox[{"-", FractionBox["1",
