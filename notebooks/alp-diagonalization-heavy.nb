              "\[IndentingNewLine]", RowBox[{RowBox[{"LPheavyALPnonDerivatives", "=",
                  RowBox[{"LPheavyALPnonDerivatives", "-", "PheavyALPmassTerm"}]}], ";"}],
              "\[IndentingNewLine]", RowBox[{"PheavyALPmassTerm", "=", RowBox[
                 {RowBox[{"PheavyALPmassTerm", "-", RowBox[{"Sum", "[", RowBox[{RowBox[
