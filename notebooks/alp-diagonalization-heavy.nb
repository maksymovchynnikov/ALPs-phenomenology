     Cell[CellGroupData[{Cell["Mass and kinetic matrices", "Section",
         ExpressionUUID -> "58b95aea-a140-954b-8b7d-288624aeffdc"],
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{"listMesonP0heavya", "=", RowBox[{"Join", "[",
                  RowBox[{RowBox[{"{", "\"a\"", "}"}], ",", "listMesonP0heavy"}], "]"}]}],
              "\[IndentingNewLine]", RowBox[{"Print", "[", "\"Mass matrix L = \
-\!\(\*FractionBox[\(1\), \(2\)]\)\!\(\*SubscriptBox[\(P\), \(i\)]\)\!\(\*SubscriptBox[\(P\), \
\(j\)]\)\!\(\*SubscriptBox[\(M\), \(ij\)]\):\"", "]"}], "\[IndentingNewLine]",
              RowBox[{RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[
                     {RowBox[{RowBox[{"Mm0heavyX", "[", RowBox[{"particle1", ",", "particle2"}],
                          "]"}], "=", RowBox[{RowBox[{"-", RowBox[{"D", "[", RowBox[
                               {"PheavyALPmassTerm", ",", RowBox[{"If", "[", RowBox[{RowBox[
                                 {"particle1", "==", "\"a\""}], ",", RowBox[{"alp", "[", "x",
                                 "]"}], ",", RowBox[{"PheavyFieldSymbol", "[", RowBox[{"particle1",
                                 ",", "x"}], "]"}]}], "]"}], ",", RowBox[{"If", "[", RowBox[
                                 {RowBox[{"particle2", "==", "\"a\""}], ",", RowBox[{"alp", "[",
                                 "x", "]"}], ",", RowBox[{"PheavyFieldSymbol", "[", RowBox[
                                 {"particle2", ",", "x"}], "]"}]}], "]"}]}], "]"}]}], "//",
                          "FullSimplify"}]}], ";", "\[IndentingNewLine]", RowBox[{"(*",
                        RowBox[{RowBox[{"Converting", " ", "the", " ", "mass", " ", "coefficients",
                            " ", "into", " ", "S4", " ", "from", " ", RowBox[{"https", ":"}]}],
                          "//", RowBox[{RowBox[{RowBox[{"arxiv", ".", "org"}], "/", "pdf"}], "/",
                            RowBox[{"1811.03474", ".", "pdf"}]}]}], "*)"}], "\[IndentingNewLine]",
                      RowBox[{RowBox[{"Mm0heavyXred", "[", RowBox[{"particle1", ",", "particle2"}],
                          "]"}], "=", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"(",
                                 RowBox[{RowBox[{"particle1", "==", "\"a\""}], "||", RowBox[
                                 {"particle2", "==", "\"a\""}]}], ")"}], "&&", RowBox[{"particle1",
                                 "!=", "particle2"}]}], ",", FractionBox["1", "\[Epsilon]"], ",",
                              "1"}], "]"}], "*", RowBox[{"Mm0heavyX", "[", RowBox[{"particle1",
                              ",", "particle2"}], "]"}]}]}]}], "\[IndentingNewLine]", ",",
                    RowBox[{"{", RowBox[{"particle1", ",", "listMesonP0heavya"}], "}"}], ",",
                    RowBox[{"{", RowBox[{"particle2", ",", "listMesonP0heavya"}], "}"}]}], "]"}],
                ";"}], "\[IndentingNewLine]", RowBox[{"Join", "[", RowBox[
                 {RowBox[{"{", RowBox[{RowBox[{"{", "\"\"", "}"}], ",", RowBox[{"{", "\"a\"",
                        "}"}], ",", RowBox[{"{",
                        "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)(1300)\"", "}"}], ",",
                      RowBox[{"{", "\"\[Eta](1295)\"", "}"}], ",", RowBox[{"{", "\"\[Eta](1440)\"",
                        "}"}]}], "}"}], ",", RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[
                         {"{", RowBox[{"\"a\"", ",",
                            "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)(1300)\"", ",",
                            "\"\[Eta](1295)\"", ",", "\"\[Eta](1440)\""}], "}"}], "}"}], ",",
                      RowBox[{"Table", "[", RowBox[{RowBox[{"Mm0heavyX", "[", RowBox[{"particle1",
                              ",", "particle2"}], "]"}], ",", RowBox[{"{", RowBox[{"particle1",
                              ",", "listMesonP0heavya"}], "}"}], ",", RowBox[{"{", RowBox[
                             {"particle2", ",", "listMesonP0heavya"}], "}"}]}], "]"}]}], "]"}],
                  ",", "2"}], "]"}], "\[IndentingNewLine]", RowBox[{"Print", "[", "\"Kinetic matrix \
L = \!\(\*FractionBox[\(1\), \(2\)]\)\!\(\*SubscriptBox[\(dP\), \(i\)]\)\!\(\*SubscriptBox[\(dP\), \
\(j\)]\)\!\(\*SubscriptBox[\(K\), \(ij\)]\):\"", "]"}], "\[IndentingNewLine]",
              RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[
                     {RowBox[{"Km0heavyX", "[", RowBox[{"particle1", ",", "particle2"}], "]"}],
                      "=", RowBox[{RowBox[{"D", "[", RowBox[{"LPheavyALPkinetic", ",", RowBox[
                             {"If", "[", RowBox[{RowBox[{"particle1", "==", "\"a\""}], ",",
                                RowBox[{"dalp", "[", RowBox[{"x", ",", "\[Mu]"}], "]"}], ",",
                                RowBox[{"dPheavyFieldSymbol", "[", RowBox[{"particle1", ",", "x",
                                 ",", "\[Mu]"}], "]"}]}], "]"}], ",", RowBox[{"If", "[", RowBox[
                               {RowBox[{"particle2", "==", "\"a\""}], ",", RowBox[{"dalp", "[",
                                 RowBox[{"x", ",", "\[Mu]"}], "]"}], ",", RowBox[
                                 {"dPheavyFieldSymbol", "[", RowBox[{"particle2", ",", "x", ",",
                                 "\[Mu]"}], "]"}]}], "]"}]}], "]"}], "//", "Simplify"}]}], ";",
                    "\[IndentingNewLine]", RowBox[{"(*", RowBox[{RowBox[{"Converting", " ", "the",
                          " ", "kinetic", " ", "coefficients", " ", "into", " ", "S4", " ", "from",
                          " ", RowBox[{"https", ":"}]}], "//", RowBox[{RowBox[{RowBox[{"arxiv",
                              ".", "org"}], "/", "pdf"}], "/", RowBox[{"1811.03474", ".",
                            "pdf"}]}]}], "*)"}], "\[IndentingNewLine]", RowBox[
                     {RowBox[{"Km0heavyXred", "[", RowBox[{"particle1", ",", "particle2"}], "]"}],
                      "=", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                                 {RowBox[{"particle1", "==", "\"a\""}], "||", RowBox[{"particle2",
                                 "==", "\"a\""}]}], ")"}], "&&", RowBox[{"particle1", "!=",
                                "particle2"}]}], ",", RowBox[{"-", FractionBox["1",
                               "\[Epsilon]"]}], ",", "1"}], "]"}], "*", RowBox[{"Km0heavyX", "[",
                          RowBox[{"particle1", ",", "particle2"}], "]"}]}]}]}], ",",
                  RowBox[{"{", RowBox[{"particle1", ",", "listMesonP0heavya"}], "}"}], ",",
                  RowBox[{"{", RowBox[{"particle2", ",", "listMesonP0heavya"}], "}"}]}], "]"}],
              "\[IndentingNewLine]", RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[
                     {RowBox[{"{", "\"\"", "}"}], ",", RowBox[{"{", "\"a\"", "}"}], ",",
                      RowBox[{"{", "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)(1300)\"", "}"}],
                      ",", RowBox[{"{", "\"\[Eta](1295)\"", "}"}], ",", RowBox[{"{",
                        "\"\[Eta](1440)\"", "}"}]}], "}"}], ",", RowBox[{"Join", "[",
                    RowBox[{RowBox[{"{", RowBox[{"{", RowBox[{"\"a\"", ",",
                            "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)(1300)\"", ",",
                            "\"\[Eta](1295)\"", ",", "\"\[Eta](1440)\""}], "}"}], "}"}], ",",
                      RowBox[{"Table", "[", RowBox[{RowBox[{"Km0heavyX", "[", RowBox[{"particle1",
                              ",", "particle2"}], "]"}], ",", RowBox[{"{", RowBox[{"particle1",
                              ",", "listMesonP0heavya"}], "}"}], ",", RowBox[{"{", RowBox[
                             {"particle2", ",", "listMesonP0heavya"}], "}"}]}], "]"}]}], "]"}],
                  ",", "2"}], "]"}]}], "Input", ExpressionUUID ->
