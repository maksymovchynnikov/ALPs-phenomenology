                 RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"Mm0m0Red", "[", RowBox[{"meson1", ",",
                           "meson2"}], "]"}], "=", RowBox[{RowBox[{"If", "[", RowBox[
                            {RowBox[{"meson1", "==", "meson2"}], ",", "1", ",", FractionBox[
                              RowBox[{"md", "+", "mu"}], RowBox[{"md", "-", "mu"}]]}], "]"}], "*",
                         RowBox[{"Mm0m0", "[", RowBox[{"meson1", ",", "meson2"}], "]"}]}]}], ",",
