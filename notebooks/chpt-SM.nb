                                 "m\[Pi]0", "2"]}]}], ")"}], "4"]}], "==", "tempval"}], ",",
                                 "mK02"}], "]"}], "[", RowBox[{"[", "1", "]"}], "]"}]}], "//",
                            "Simplify"}]}]}], ";"}], "\[IndentingNewLine]", RowBox[{"tempval", "=",
                      RowBox[{RowBox[{RowBox[{RowBox[{"m2ChPTminimal", "[", "\"\[Eta]\"", "]"}],
                            "-", RowBox[{"(", RowBox[{FractionBox[RowBox[{RowBox[{"4", RowBox[
