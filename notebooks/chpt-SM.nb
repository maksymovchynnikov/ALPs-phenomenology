           Cell[CellGroupData[{Cell["Relation between masses of mesons in pure ChPT+anomaly",
               "Subsection", ExpressionUUID -> "c485d9db-bd11-ef4b-a09f-b02a08c188e9"],
              Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"Do", "[", "\[IndentingNewLine]",
                        RowBox[{RowBox[{RowBox[{"m2ChPTminimal", "[", "meson", "]"}], "=",
                            RowBox[{RowBox[{"-", RowBox[{"D", "[", RowBox[{"MassTermChPTtemp1",
                                 ",", RowBox[{"PfieldSymbol", "[", RowBox[{"meson", ",", "x"}],
                                 "]"}], ",", RowBox[{"PfieldSymbol", "[", RowBox[{RowBox[
                                 {"findingConjugated", "[", "meson", "]"}], ",", "x"}], "]"}]}],
                                 "]"}]}], "//", "Simplify"}]}], "\[IndentingNewLine]", ",",
                          RowBox[{"{", RowBox[{"meson", ",", "listMesonP"}], "}"}]}], "]"}],
                      "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"Expressing", " ", "the", " ",
                          "d", " ", "quark", " ", "mass", " ", "in", " ", "terms", " ", "of", " ",
                          SubscriptBox["m", "\[Eta]"], " ", "and", " ", SubscriptBox["m",
                           RowBox[{"\[Eta]", "'"}]]}], "*)"}]}], "\[IndentingNewLine]",
                    RowBox[{RowBox[{RowBox[{"mdsol", "[", "\"\[Eta]\"", "]"}], "=", RowBox[
                         {RowBox[{"md", "/.", RowBox[{RowBox[{"Solve", "[", RowBox[{RowBox[
                                 {RowBox[{"(", RowBox[{RowBox[{"Mm0m0", "[", RowBox[{"\"\[Eta]\"",
                                 ",", "\"\[Eta]\""}], "]"}], "/.", RowBox[{"{", RowBox[{"mu", "->",
                                 "mu\[Delta]sol"}], "}"}]}], ")"}], "==", SuperscriptBox["m\[Eta]",
                                 "2"]}], ",", "md"}], "]"}], "[", RowBox[{"[", "1", "]"}], "]"}]}],
                          "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", RowBox[
                     {RowBox[{RowBox[{RowBox[{"mdsol", "[", "\"\[Eta]'\"", "]"}], "=", RowBox[
                           {RowBox[{"md", "/.", RowBox[{RowBox[{"Solve", "[", RowBox[{RowBox[
                                 {RowBox[{"(", RowBox[{RowBox[{"Mm0m0", "[", RowBox[{"\"\[Eta]'\"",
                                 ",", "\"\[Eta]'\""}], "]"}], "/.", RowBox[{"{", RowBox[{"mu",
                                 "->", "mu\[Delta]sol"}], "}"}]}], ")"}], "==", SuperscriptBox[
                                 "m\[Eta]pr", "2"]}], ",", "md"}], "]"}], "[", RowBox[{"[", "1",
                                 "]"}], "]"}]}], "//", "Simplify"}]}], ";"}],
                      "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"Some", " ", "relations", " ",
                          "between", " ", "various", " ", "masses", " ", "in", " ", "pure", " ",
                          "ChPT"}], "*)"}]}], "\[IndentingNewLine]", RowBox[{RowBox[{"tempval",
                        "=", RowBox[{RowBox[{RowBox[{RowBox[{"m2ChPTminimal", "[", "\"\[Eta]\"",
                                "]"}], "-", RowBox[{"(", RowBox[{FractionBox[RowBox[{RowBox[{"4",
                                 RowBox[{"m2ChPTminimal", "[",
                                 "\"\!\(\*SubscriptBox[\(K\), \(L\)]\)\"", "]"}]}], "-", RowBox[
                                 {"2", RowBox[{"m2ChPTminimal", "[",
                                 "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", "]"}]}]}], "4"],
                                 "-", RowBox[{FractionBox["1", "2"], RowBox[{"(", RowBox[
                                 {"\[Delta]", "-", "1"}], ")"}], RowBox[{"(*", SuperscriptBox[
