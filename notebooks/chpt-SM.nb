                                 {"\[Delta]I", "*", "M\[Pi]0\[Eta]pr"}]}], "}"}], ",", RowBox[
                                {"{", RowBox[{RowBox[{"\[Delta]I", "*", "M\[Pi]0\[Eta]"}], ",",
                                 SuperscriptBox["m\[Eta]", "2"], ",", "0"}], "}"}], ",", RowBox[
                                {"{", RowBox[{RowBox[{"\[Delta]I", "*", "M\[Pi]0\[Eta]pr"}], ",",
                                 "0", ",", SuperscriptBox["m\[Eta]pr", "2"]}], "}"}]}], "}"}], ".",
                           RowBox[{"{", RowBox[{RowBox[{"\[Pi]0", "[", "x", "]"}], ",", RowBox[
                                {"\[Eta]", "[", "x", "]"}], ",", RowBox[{"\[Eta]pr", "[", "x",
                                 "]"}]}], "}"}]}]}], "//", "Expand"}], "//", "Simplify"}]}]}],
