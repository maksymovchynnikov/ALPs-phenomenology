                           "3"]]}]}], "}"}], ";"}], "\[IndentingNewLine]", RowBox[{"Print", "[", "\
\"ChPT mass term in symbolic form following the notation of Eq. S4 from \
https://arxiv.org/pdf/1811.03474.pdf, with \!\(\*SubscriptBox[\(\[Delta]\), \(I\)]\) = \
(\!\(\*SubscriptBox[\(m\), \(d\)]\)-\!\(\*SubscriptBox[\(m\), \(u\)]\))/(\!\(\*SubscriptBox[\(m\), \
\(d\)]\)+\!\(\*SubscriptBox[\(m\), \(u\)]\)):\"", "]"}], "\[IndentingNewLine]",
                 RowBox[{"MassTermChPTsymbolic", "=", RowBox[{RowBox[{RowBox[{RowBox[{"-",
                           FractionBox["1", "2"]}], RowBox[{RowBox[{"{", RowBox[{RowBox[{"\[Pi]0",
                                 "[", "x", "]"}], ",", RowBox[{"\[Eta]", "[", "x", "]"}], ",",
                               RowBox[{"\[Eta]pr", "[", "x", "]"}]}], "}"}], ".", RowBox[{"{",
                             RowBox[{RowBox[{"{", RowBox[{SuperscriptBox["m\[Pi]0", "2"], ",",
