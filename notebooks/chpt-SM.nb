                     {RowBox[{RowBox[{"M2relationPureChPT", "[",
                          "\"\!\(\*SubscriptBox[\(K\), \(L\)]\)\"", "]"}], "=", RowBox[
                         {RowBox[{"M2relationPureChPT", "[",
