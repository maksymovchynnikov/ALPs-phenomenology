                          "\"\!\(\*SuperscriptBox[\(K\), \(+\)]\)\"", "]"}], "=", RowBox[
                         {RowBox[{"M2relationPureChPT", "[",
                            "\"\!\(\*SuperscriptBox[\(K\), \(-\)]\)\"", "]"}], "=", RowBox[
                           {RowBox[{"mK02", "/.", RowBox[{RowBox[{"Solve", "[", RowBox[{RowBox[
