                                 {"(", RowBox[{RowBox[{"-", "\[Delta]"}], "-", "1"}], ")"}],
                                 SuperscriptBox["m\[Pi]0", "2"]}]}], ")"}], "4"]}], "==",
                                 "tempval"}], ",", "mK02"}], "]"}], "[", RowBox[{"[", "1", "]"}],
                                "]"}]}], "//", "Simplify"}]}]}], ";"}], "\[IndentingNewLine]",
                    RowBox[{RowBox[{"tempval", "=", RowBox[{"Simplify", "[", RowBox[
