Notebook[{Cell[CellGroupData[{Cell["Matrix elements exporting (for SensCalc)", "Section",
      ExpressionUUID -> "16b2340e-d191-4708-80b3-fecd20c3d662"],
     Cell[CellGroupData[{Cell["Matrix element for KK\[Pi] processes without the interpolation part \
(including it would enormously slows down SensCalc calculations)", "Subsection",
         ExpressionUUID -> "8586634f-bd39-4384-afc4-77741cc5e765"],
        Cell[BoxData[RowBox[{"Do", "[", "\[IndentingNewLine]",
            RowBox[{RowBox[{RowBox[{"sublistexport", "=", RowBox[{"{", RowBox[{"\"Pure ChPT\"",
                      ",", "\"\!\(\*SubscriptBox[\(f\), \(2\)]\)-mediated\"", ",",
                      "\"S-mediated\"", ",", "\"V-mediated\"", ",", "\"VA-Pheavy\""}], "}"}]}],
                ";", "\[IndentingNewLine]", RowBox[{RowBox[{"Msymbolic3bodyExp", "[",
                    RowBox[{"process", ",", "\"Total\""}], "]"}], "=", RowBox[{"Sum", "[",
                    RowBox[{RowBox[{"Msymbolic3body", "[", RowBox[{"process", ",", "sub"}], "]"}],
                      ",", RowBox[{"{", RowBox[{"sub", ",", "sublistexport"}], "}"}]}], "]"}]}],
                ";", "\[IndentingNewLine]", RowBox[{RowBox[{"MsymbolicStar3bodyExp", "[",
                    RowBox[{"process", ",", "\"Total\""}], "]"}], "=", RowBox[{"Sum", "[",
                    RowBox[{RowBox[{"MsymbolicStar3body", "[", RowBox[{"process", ",", "sub"}],
                        "]"}], ",", RowBox[{"{", RowBox[{"sub", ",", "sublistexport"}], "}"}]}],
                    "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"M2numeric3bodyExp", "[",
                    RowBox[{"process", ",", "ma_", ",", "fa_", ",", "cu_", ",", "cd_", ",", "cs_",
                      ",", "cc_", ",", "cb_", ",", "ct_", ",", "cG_", ",", "c\[Gamma]_", ",",
                      "ce_", ",", "c\[Mu]_", ",", "c\[Tau]_", ",", "m12_", ",", "m23_"}], "]"}],
                  "=", RowBox[{RowBox[{"symbolsToNumbersWidths", "[", RowBox[{RowBox[
                         {"Msymbolic3bodyExp", "[", RowBox[{"process", ",", "\"Total\""}], "]"}],
                        "*", RowBox[{"MsymbolicStar3bodyExp", "[", RowBox[{"process", ",",
                            "\"Total\""}], "]"}]}], "]"}], "*", SuperscriptBox[RowBox[{"Ffunction",
                       "[", "ma", "]"}], "2"]}]}]}], "\[IndentingNewLine]", ",",
              RowBox[{"{", RowBox[{"process", ",", "proclistKK\[Pi]"}], "}"}]}], "]"}]], "Input",
         ExpressionUUID -> "be9b0baa-bbc2-4e7c-8bcc-3f3435ea627b"]}, Open]],
     Cell[CellGroupData[{Cell["The exported K Kbar pi shapes omit only the interpolation-based \
BaBar amplitude, including its interference; VA-Pheavy is retained. If this leaves K_L K_S pi0 with \
zero amplitude, that channel uses uniform three-body phase space. These shape approximations do not \
change the separately exported widths or branching fractions.", "Text"],
        Cell["Exporting block", "Subsection", ExpressionUUID ->
          "ba3e669a-c4f1-4d42-9a7a-8926daff3c97"],
        Cell[BoxData[RowBox[{RowBox[{"BlockMsquaredTabulation", "[", RowBox[{"Model_", ",",
                "\[CapitalLambda]_", ",", "proclist_"}], "]"}], ":=",
            RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"M2numeric3bodyExport", ",",
                    "listtoexport", ",", "modexp"}], "}"}], ",", "\[IndentingNewLine]",
                RowBox[{"(*", RowBox[{RowBox[{"Fixing", " ", "the", " ", "values", " ", "of", " ",
                      "the", " ", "low"}], "-", RowBox[{"energy", " ", "ALP", " ", "couplings",
                      " ", "given", " ", "the", " ", "model", " ", "and", " ",
                      "\[CapitalLambda]"}]}], "*)"}], "\[IndentingNewLine]",
                RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"crgval", "[", RowBox[
                           {"ALPcouplingslist", "[", RowBox[{"[", "i", "]"}], "]"}], "]"}], "=",
                        RowBox[{"cRGval", "[", RowBox[{"Model", ",", "\[CapitalLambda]", ",",
                            RowBox[{"ALPcouplingslist", "[", RowBox[{"[", "i", "]"}], "]"}]}],
                          "]"}]}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length",
                            "[", "ALPcouplingslist", "]"}], ",", "1"}], "}"}]}], "]"}], ";",
                  "\[IndentingNewLine]", RowBox[{"rgflow", "=", RowBox[{"Table", "[",
                      RowBox[{RowBox[{"crgval", "[", RowBox[{"ALPcouplingslist", "[", RowBox[
                             {"[", "i", "]"}], "]"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",",
                            "1", ",", RowBox[{"Length", "[", "ALPcouplingslist", "]"}], ",", "1"}],
                          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"(*",
                    RowBox[{"The", " ", SubscriptBox["c", "\[Gamma]\[Gamma]"], " ", "coupling",
                      " ", "smoothly", " ", "glued", " ", "between", " ", "the", " ", "ChPT", " ",
                      "regime", " ", "and", " ", "the", " ", "QCD", " ", "perturbative", " ",
                      "regime"}], "*)"}], "\[IndentingNewLine]", RowBox[{RowBox[{"c\[Gamma]glued",
                      "[", "ma_", "]"}], "=", RowBox[{"c\[Gamma]Gluing", "[", RowBox[{"ma", ",",
                        RowBox[{"crgval", "[", "\"cu\"", "]"}], ",", RowBox[{"crgval", "[",
                          "\"cd\"", "]"}], ",", RowBox[{"crgval", "[", "\"cs\"", "]"}], ",",
                        RowBox[{"crgval", "[", "\"cc\"", "]"}], ",", RowBox[{"crgval", "[",
                          "\"cb\"", "]"}], ",", RowBox[{"crgval", "[", "\"ct\"", "]"}], ",",
                        RowBox[{"crgval", "[", "\"cG\"", "]"}], ",", RowBox[{"crgval", "[",
                          "\"ce\"", "]"}], ",", RowBox[{"crgval", "[", "\"c\[Mu]\"", "]"}], ",",
                        RowBox[{"crgval", "[", "\"c\[Tau]\"", "]"}]}], "]"}]}], ";",
                  "\[IndentingNewLine]", RowBox[{"(*", RowBox[{RowBox[{"Matrix", " ", "elements",
                        " ", "squared", " ", "in", " ", "terms", " ", "of", " ", "the", " ", "ALP",
                        " ", "mass"}], ",", " ", RowBox[{"energy", " ", "of", " ", "the", " ",
                        "particle", " ", "1", " ", "and", " ", "the", " ", "energy", " ", "of",
                        " ", "the", " ", "particle", " ", "3"}]}], "*)"}], "\[IndentingNewLine]",
                  RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"If", "[",
                          RowBox[{RowBox[{"!", RowBox[{"MemberQ", "[", RowBox[{"proclistKK\[Pi]",
                                 ",", "process"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[
                             {RowBox[{RowBox[{"M2numeric3bodyExport", "[", RowBox[{"process", ",",
                                 "ma_", ",", "E1_", ",", "E3_"}], "]"}], "=", RowBox[{RowBox[
                                 {RowBox[{RowBox[{RowBox[{"M2numeric3body", "[", RowBox[{"process",
                                 ",", "ma", ",", "1", ",", "cu", ",", "cd", ",", "cs", ",", "cc",
                                 ",", "cb", ",", "ct", ",", "cG", ",", "c\[Gamma]", ",", "ce", ",",
                                 "c\[Mu]", ",", "c\[Tau]", ",", "m12", ",", "m23"}], "]"}], "/.",
                                 RowBox[{"tableValuesReplacement", "[", RowBox[{"Model", ",",
                                 "\[CapitalLambda]"}], "]"}]}], "/.", RowBox[{"{", RowBox[{RowBox[
                                 {"m12", "->", RowBox[{"M12", "[", RowBox[{"E1", ",", "E3"}],
                                 "]"}]}], ",", RowBox[{"m23", "->", RowBox[{"M23", "[", "E1",
                                 "]"}]}]}], "}"}]}], "/.", RowBox[{"{", RowBox[{RowBox[{"m", "->",
                                 "ma"}], ",", RowBox[{"m1", "->", RowBox[{"MASS", "[", RowBox[
                                 {RowBox[{"particleslist", "[", "process", "]"}], "[", RowBox[{"[",
                                 "1", "]"}], "]"}], "]"}]}], ",", RowBox[{"m2", "->", RowBox[
                                 {"MASS", "[", RowBox[{RowBox[{"particleslist", "[", "process",
                                 "]"}], "[", RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", RowBox[
                                 {"m3", "->", RowBox[{"MASS", "[", RowBox[{RowBox[{"particleslist",
                                 "[", "process", "]"}], "[", RowBox[{"[", "3", "]"}], "]"}],
                                 "]"}]}]}], "}"}]}], "/.", RowBox[{"{", RowBox[{RowBox[
                                 {"Ffunction", "[", "ma", "]"}], "->", "1"}], "}"}]}]}], ";"}],
                            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", RowBox[
                             {RowBox[{"M2numeric3bodyExport", "[", RowBox[{"process", ",", "ma_",
                                 ",", "E1_", ",", "E3_"}], "]"}], "=", RowBox[{RowBox[{RowBox[
                                 {RowBox[{RowBox[{"M2numeric3bodyExp", "[", RowBox[{"process", ",",
                                 "ma", ",", "1", ",", "cu", ",", "cd", ",", "cs", ",", "cc", ",",
                                 "cb", ",", "ct", ",", "cG", ",", "c\[Gamma]", ",", "ce", ",",
                                 "c\[Mu]", ",", "c\[Tau]", ",", "m12", ",", "m23"}], "]"}], "/.",
                                 RowBox[{"tableValuesReplacement", "[", RowBox[{"Model", ",",
                                 "\[CapitalLambda]"}], "]"}]}], "/.", RowBox[{"{", RowBox[
                                 {RowBox[{"m12", "->", RowBox[{"M12", "[", RowBox[{"E1", ",",
                                 "E3"}], "]"}]}], ",", RowBox[{"m23", "->", RowBox[{"M23", "[",
                                 "E1", "]"}]}]}], "}"}]}], "/.", RowBox[{"{", RowBox[{RowBox[
                                 {"m", "->", "ma"}], ",", RowBox[{"m1", "->", RowBox[{"MASS", "[",
                                 RowBox[{RowBox[{"particleslist", "[", "process", "]"}], "[",
                                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", RowBox[{"m2", "->",
                                 RowBox[{"MASS", "[", RowBox[{RowBox[{"particleslist", "[",
                                 "process", "]"}], "[", RowBox[{"[", "2", "]"}], "]"}], "]"}]}],
                                 ",", RowBox[{"m3", "->", RowBox[{"MASS", "[", RowBox[{RowBox[
                                 {"particleslist", "[", "process", "]"}], "[", RowBox[{"[", "3",
                                 "]"}], "]"}], "]"}]}]}], "}"}]}], "/.", RowBox[{"{", RowBox[
                                 {RowBox[{"Ffunction", "[", "ma", "]"}], "->", "1"}], "}"}]}]}]}],
                          "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
                      RowBox[{"{", RowBox[{"process", ",", "proclist"}], "}"}]}], "]"}], ";",
                  "\[IndentingNewLine]", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{",
                          RowBox[{"channel", "=", "\"\\!\\(\\*SuperscriptBox[\\(\[Omega]\[Pi]\\), \
\\(+\\)]\\)\\!\\(\\*SuperscriptBox[\\(\[Pi]\\), \\(-\\)]\\)\""}], "}"}], ",", RowBox[{"If", "[",
                          RowBox[{RowBox[{"MemberQ", "[", RowBox[{"proclist", ",", "channel"}],
                              "]"}], ",", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                                 {"coefficient", "=", RowBox[{"symbolsToNumbersWidths", "[",
                                 RowBox[{"Cancel", "[", RowBox[{"-", FractionBox[RowBox[
                                 {"Coefficient", "[", RowBox[{RowBox[{"M2symbolic3body", "[",
                                 "channel", "]"}], ",", "m12", ",", "2"}], "]"}], "m23"]}], "]"}],
                                 "]"}]}], "}"}], ",", RowBox[{RowBox[{"M2numeric3bodyExport", "[",
                                 RowBox[{"channel", ",", "mass_", ",", "E1_", ",", "E3_"}], "]"}],
                                 "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[
                                 {"s", "=", RowBox[{SuperscriptBox["mass", "2"], "+",
                                 SuperscriptBox[RowBox[{"MASS", "[", "\"\[Omega]\"", "]"}], "2"],
                                 "-", RowBox[{"2", " ", "mass", " ", "E1"}]}]}], ",", RowBox[
                                 {"centre", "=", FractionBox[RowBox[{"mass", "-", "E1"}], "2"]}]}],
                                 "}"}], ",", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                                 {"halfRange", "=", RowBox[{FractionBox["1", "2"], " ", SqrtBox[
                                 FractionBox[RowBox[{RowBox[{"(", RowBox[{"E1", "-", RowBox[
                                 {"MASS", "[", "\"\[Omega]\"", "]"}]}], ")"}], " ", RowBox[{"(",
                                 RowBox[{"E1", "+", RowBox[{"MASS", "[", "\"\[Omega]\"", "]"}]}],
                                 ")"}], " ", RowBox[{"(", RowBox[{"s", "-", RowBox[{"4", " ",
                                 SuperscriptBox[RowBox[{"MASS", "[", RowBox[{RowBox[{
                                 "particleslist", "[", "channel", "]"}], "\[LeftDoubleBracket]",
                                 "2", "\[RightDoubleBracket]"}], "]"}], "2"]}]}], ")"}]}],
                                 "s"]]}]}], "}"}], ",", RowBox[{"4", " ", SuperscriptBox["mass",
                                 "2"], " ", "s", " ", RowBox[{"(", RowBox[{"centre", "+",
                                 "halfRange", "-", "E3"}], ")"}], " ", RowBox[{"(", RowBox[{"E3",
                                 "-", "centre", "+", "halfRange"}], ")"}], " ", RowBox[{"(", RowBox[
                                 {RowBox[{"coefficient", "/.", "\[VeryThinSpace]", RowBox[
                                 {"tableValuesReplacement", "[", RowBox[{"Model", ",",
                                 "\[CapitalLambda]"}], "]"}]}], "/.", "\[VeryThinSpace]", RowBox[
                                 {"{", RowBox[{RowBox[{"fa", "\[Rule]", "1"}], ",", RowBox[{"ma",
                                 "\[Rule]", "mass"}], ",", RowBox[{"m23", "\[Rule]", "s"}]}],
                                 "}"}]}], ")"}]}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], "]"}],
                    ";"}], ";", "\[IndentingNewLine]", RowBox[{"listtoexport", "=", RowBox[
                     {"{", RowBox[{"proclist", ",", RowBox[{"Table", "[", RowBox[{RowBox[
                             {"particleslist", "[", "proc", "]"}], ",", RowBox[{"{", RowBox[
                               {"proc", ",", "proclist"}], "}"}]}], "]"}], ",", RowBox[{"Table",
                          "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"value",
                                 "=", RowBox[{"M2numeric3bodyExport", "[", RowBox[{"process", ",",
                                 "mLLP", ",", "E1", ",", "E3"}], "]"}]}], "}"}], ",", RowBox[
                                 {"If", "[", RowBox[{RowBox[{RowBox[{"process", "==", "\"\\!\\(\\*S\
ubscriptBox[\\(K\\), \\(L\\)]\\)\\!\\(\\*SubscriptBox[\\(K\\), \
\\(S\\)]\\)\\!\\(\\*SuperscriptBox[\\(\[Pi]\\), \\(0\\)]\\)\""}], "&&", RowBox[{"TrueQ", "[",
                                 RowBox[{"value", "==", "0"}], "]"}]}], ",", "1.`", ",", "value"}],
                                 "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"process", ",",
                                "proclist"}], "}"}]}], "]"}]}], "}"}]}], ";",
                  "\[IndentingNewLine]", RowBox[{StyleBox[RowBox[{"BlockMsquaredTabulation", "::",
                       "invalid"}], "MessageName"], "=", "\"Export cancelled: a matrix element \
contains an interpolation or an invalid expression.\""}], ";", "\[IndentingNewLine]",
                  RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[
                           {"listtoexport", ",", RowBox[{"_InterpolatingFunction", "|", "_Pyramid",
                              "|", "Indeterminate", "|", "_DirectedInfinity"}]}], "]"}]}], ",",
                      RowBox[{RowBox[{"Message", "[", StyleBox[RowBox[{"BlockMsquaredTabulation",
                             "::", "invalid"}], "MessageName"], "]"}], ";", RowBox[{"Return", "[",
                          "$Failed", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]",
                  RowBox[{"modexp", "=", RowBox[{"If", "[", RowBox[{"If\[Kappa]Inv", ",", "Model",
                        ",", RowBox[{"Model", "<>", "\"-kappa\""}]}], "]"}]}], ";",
                  "\[IndentingNewLine]", RowBox[{"modexp", "=", RowBox[{"If", "[", RowBox[
                       {"IfPheavy", ",", "modexp", ",", RowBox[{"Model", "<>",
                          "\"-No-Pheavy\""}]}], "]"}]}], ";", "\[IndentingNewLine]",
                  RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{",
                          RowBox[{RowBox[{RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], "//",
                                "ParentDirectory"}], "//", "ParentDirectory"}], ",",
                            "\"phenomenology\"", ",", "modexp", ",", "\"decays\"", ",", RowBox[
                             {"ToString", "@", RowBox[{"StringForm", "[", RowBox[
                                 {"\"Matrix-elements-squared-model-``-scale-``-GeV.m\"", ",",
                                 RowBox[{"Sequence", "@@", RowBox[{"{", RowBox[{"modexp", ",",
                                 RowBox[{RowBox[{"\[CapitalLambda]", "//", "CForm"}], "//",
                                 "ToString"}]}], "}"}]}]}], "]"}]}]}], "}"}], "]"}], ",",
                      "listtoexport", ",", "\"MX\""}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]],
         "Input", ExpressionUUID -> "57d05496-25a6-41ad-a60c-9d7e498933e4"]}, Open]],
     Cell[CellGroupData[{Cell["Exporting", "Subsection", ExpressionUUID ->
          "9f347caa-1143-48ec-a0f1-8f4428b0c1be"],
        Cell[CellGroupData[{Cell[BoxData[""], "Input", ExpressionUUID ->
             "9d1b85b2-0fd6-1e4e-b301-7642bd2516c1"]}, Open]],
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{"Print", "[", "\"Model for exporting:\"", "]"}],
              "\[IndentingNewLine]", RowBox[{"ModelForExporting", "=", RowBox[{"dropdownDialog",
                  "[", RowBox[{"ModelListAll", ",",
                    "\"Select the model for squared matrix elements exporting:\""}], "]"}]}],
              "\[IndentingNewLine]", RowBox[{"Print", "[", "\"Scale \[CapitalLambda]:\"", "]"}],
              "\[IndentingNewLine]", RowBox[{"\[CapitalLambda]Choice", "=", RowBox[
                 {RowBox[{"DialogInput", "[", RowBox[{RowBox[{"{", RowBox[{"cut", "=", "1000"}],
                        "}"}], ",", RowBox[{"Column", "[", RowBox[{"{", RowBox[
                           {"\"Enter the scale \[CapitalLambda] in GeV:\"", ",", RowBox[
                             {"InputField", "[", RowBox[{RowBox[{"Dynamic", "[", "cut", "]"}], ",",
                                "Expression"}], "]"}], ",", RowBox[{"Button", "[", RowBox[
                               {"\"Proceed\"", ",", RowBox[{"DialogReturn", "[", "cut", "]"}], ",",
                                RowBox[{"ImageSize", "\[Rule]", "Automatic"}]}], "]"}]}], "}"}],
                        "]"}]}], "]"}], "//", "N"}]}], "\[IndentingNewLine]", RowBox[{"Print", "[",
                "\"For which processes the matrix elements will be exported:\"", "]"}],
              "\[IndentingNewLine]", RowBox[{RowBox[{"DecayProcessesList3body", "=",
                  RowBox[{"Select", "[", RowBox[{RowBox[{RowBox[{"Keys", "[", RowBox[{"DownValues",
                            "@", "particleslist"}], "]"}], "[", RowBox[{"[", RowBox[{"All", ",",
                            "1", ",", "1"}], "]"}], "]"}], ",", RowBox[{RowBox[{RowBox[{"Length",
                            "[", RowBox[{"particleslist", "[", "#", "]"}], "]"}], "==", "3"}],
                        "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
              RowBox[{"DecayProcessesForExporting", "=", RowBox[{"(*", RowBox[{"selectionDialog",
                    "[", RowBox[{"DecayProcessesList", ",",
                      "\"Select the list of decays for which the matrix elements will be \
exported:\""}], "]"}], "*)"}], "DecayProcessesList3body"}], "\[IndentingNewLine]",
              RowBox[{"BlockMsquaredTabulation", "[", RowBox[{"ModelForExporting", ",",
                  "\[CapitalLambda]Choice", ",", "DecayProcessesForExporting"}], "]"}]}], "Input",
            ExpressionUUID -> "1932db1a-ec17-4136-af0b-6b7ff41fff6b"]}, Open]]}, Open]]}, Open]]},
