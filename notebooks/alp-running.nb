       RowBox[{"\"\<cG\>\"", ",", "\[Mu]_"}], "]"}], ",", 
      RowBox[{"RunningCoupling", "[", 
       RowBox[{"\"\<cW\>\"", ",", "\[Mu]_"}], "]"}], ",", 
