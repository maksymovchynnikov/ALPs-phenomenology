Cell[CellGroupData[{

Cell["RG flow computation/importing", "Subsection",
 CellChangeTimes->{{3.9054819969874463`*^9, 
  3.90548200311333*^9}},ExpressionUUID->"60c59c6b-8299-4036-a9d0-\
2fa53400e248"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalLambda]listInt", "=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       SuperscriptBox["10", "x"], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Log10", "[", 
          RowBox[{
           RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], "//", "N"}], "]"}], ",", 
         RowBox[{"Log10", "[", 
          SuperscriptBox["10", "12."], "]"}], ",", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log10", "[", 
             SuperscriptBox["10", "12."], "]"}], "-", 
            RowBox[{"Log10", "[", 
             RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], "]"}]}], ")"}], 
          "230"]}], "}"}]}], "]"}], "//", "Developer`ToPackedArray"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"rgflowcomputoption", "=", 
     RowBox[{"dropdownDialog", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Generate\>\"", ",", "\"\<Import\>\""}], "}"}], ",", 
       "\"\<Generate the RG flow of the ALP couplings, or just import it (if \
it has been generated once)?\>\""}], "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"rgflowcomputoption", "=", "\"\<Import\>\""}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fileRG", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
      ",", "\"\<Temporary data/RGflowModels.m\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RGexists", "=", 
   RowBox[{"FileExistsQ", "[", "fileRG", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", "RGexists"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "infoDialog", "[", 
     "\"\<The RG flow of the ALP couplings has not been generated yet. It \
will be done once and require a few minutes\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"rgflowlist", "[", "model", "]"}], "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "\[CapitalLambda]", "}"}], ",", 
              RowBox[{
               RowBox[{"ALPcouplingsRGflow", "[", 
                RowBox[{"model", ",", "\[CapitalLambda]"}], "]"}], "//", 
               "Quiet"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[CapitalLambda]", ",", "\[CapitalLambda]listInt"}], 
             "}"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"cRGval", "[", 
             RowBox[{"model", ",", "\[CapitalLambda]_", ",", 
              RowBox[{"ALPcouplingslist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "=", 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"rgflowlist", "[", "model", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{"i", "+", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
             "\[CapitalLambda]", "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "ALPcouplingslist", "]"}], ",", "1"}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tableValuesReplacement", "[", 
          RowBox[{"model", ",", "\[CapitalLambda]_"}], "]"}], "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ALPcouplingsSymbols", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "->", 
            RowBox[{"cRGval", "[", 
             RowBox[{"model", ",", "\[CapitalLambda]", ",", 
              RowBox[{"ALPcouplingslist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "ALPcouplingsSymbols", "]"}], ",", "1"}], 
            "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"model", ",", "ModelListAll"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"TabRGexport", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"model", ",", 
           RowBox[{"ALPcouplingslist", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"cRGval", "[", 
            RowBox[{"model", ",", "\[CapitalLambda]", ",", 
             RowBox[{"ALPcouplingslist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"model", ",", "ModelListAll"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "ALPcouplingslist", "]"}], ",", "1"}], 
          "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Export", "[", 
     RowBox[{"fileRG", ",", "TabRGexport", ",", "\"\<MX\>\""}], "]"}], 
    ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TabRGimport", "[", "\[CapitalLambda]_", "]"}], "=", 
   RowBox[{"Import", "[", 
    RowBox[{"fileRG", ",", "\"\<MX\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cRGval", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"TabRGimport", "[", "\[CapitalLambda]", "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[CapitalLambda]_", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"TabRGimport", "[", "\[CapitalLambda]", "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"TabRGimport", "[", "\[CapitalLambda]", "]"}], "[", 
      RowBox[{"[", "i", "]"}], "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", 
      RowBox[{"TabRGimport", "[", "\[CapitalLambda]", "]"}], "]"}], ",", 
     "1"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tableValuesReplacement", "[", 
     RowBox[{"model", ",", "\[CapitalLambda]_"}], "]"}], "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ALPcouplingsSymbols", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "->", 
       RowBox[{"cRGval", "[", 
        RowBox[{"model", ",", "\[CapitalLambda]", ",", 
         RowBox[{"ALPcouplingslist", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "ALPcouplingsSymbols", "]"}], ",", "1"}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"model", ",", "ModelListAll"}], "}"}]}], "]"}]}], "Input",
