Cell[CellGroupData[{

Cell["RG flow computation/importing", "Subsection",
 CellChangeTimes->{{3.9054819969874463`*^9, 
  3.90548200311333*^9}},ExpressionUUID->"d1c65382-01c4-45fd-a0d4-\
491b4e86e5a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fileFCNCcouplings", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
      ",", "\"\<Temporary data/FCNCcouplings.m\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", 
    RowBox[{"FileExistsQ", "[", "fileFCNCcouplings", "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FCNCcouplingList", "[", "model", "]"}], "=", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[CapitalLambda]", ",", 
            RowBox[{"Quiet", "[", 
             RowBox[{"FCNCcouplingTemp", "[", 
              RowBox[{"model", ",", "\[CapitalLambda]"}], "]"}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[CapitalLambda]", ",", "\[CapitalLambda]listInt"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"FCNCcoupling", "[", 
            RowBox[{"transition", ",", "model", ",", "\[CapitalLambda]_"}], 
            "]"}], "=", 
           RowBox[{
            RowBox[{"CKMsuppression", "[", "transition", "]"}], "*", 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"FCNCcouplingList", "[", "model", "]"}], ",", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
             "\[CapitalLambda]", "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"cij", "[", 
            RowBox[{
            "transition", ",", "model", ",", "\[CapitalLambda]_", ",", 
             "fa_"}], "]"}], "=", 
           RowBox[{
            FractionBox["1", "fa"], 
            RowBox[{"FCNCcoupling", "[", 
             RowBox[{"transition", ",", "model", ",", "\[CapitalLambda]"}], 
             "]"}], "*", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"transition", "!=", "\"\<s->d\>\""}], ",", 
              RowBox[{"MASS", "[", "\"\<b\>\"", "]"}], ",", 
              RowBox[{"MASS", "[", "\"\<s\>\"", "]"}]}], "]"}], 
            FractionBox["1", "2"]}]}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"transition", ",", "FCNCtransitions"}], "}"}]}], "]"}], 
       ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"model", ",", "ModelListAll"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"TableExportFCNCcouplings", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"transition", ",", "model", ",", 
           RowBox[{"FCNCcoupling", "[", 
            RowBox[{"transition", ",", "model", ",", "\[CapitalLambda]"}], 
            "]"}], ",", 
           RowBox[{"cij", "[", 
            RowBox[{
            "transition", ",", "model", ",", "\[CapitalLambda]", ",", "fa"}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"transition", ",", "FCNCtransitions"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"model", ",", "ModelListAll"}], "}"}]}], "]"}], ",", "1"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Export", "[", 
     RowBox[{
     "fileFCNCcouplings", ",", "TableExportFCNCcouplings", ",", 
      "\"\<MX\>\""}], "]"}]}], "\[IndentingNewLine]", ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TableImportFCNCcouplings", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"fileFCNCcouplings", ",", "\"\<MX\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"tran", "=", 
        RowBox[{
         RowBox[{"TableImportFCNCcouplings", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mod", "=", 
        RowBox[{
         RowBox[{"TableImportFCNCcouplings", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FCNCcoupling", "[", 
           RowBox[{"tran", ",", "mod", ",", "\[CapitalLambda]_"}], "]"}], ",", 
          RowBox[{"cij", "[", 
           RowBox[{"tran", ",", "mod", ",", "\[CapitalLambda]_", ",", "fa_"}],
            "]"}]}], "}"}], "=", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"TableImportFCNCcouplings", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "2"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "TableImportFCNCcouplings", "]"}], ",", "1"}], 
       "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.905481725899771*^9, 3.9054817542640934`*^9}, {
   3.905481792043293*^9, 3.905481793857354*^9}, {3.9054818250851994`*^9, 
