Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ItIntegrandCoef", "[", 
      RowBox[{"\"\<cG\>\"", ",", "\[Mu]_"}], "]"}], ",", 
     RowBox[{"ItIntegrandCoef", "[", 
      RowBox[{"\"\<cW\>\"", ",", "\[Mu]_"}], "]"}], ",", 
     RowBox[{"ItIntegrandCoef", "[", 
      RowBox[{"\"\<cB\>\"", ",", "\[Mu]_"}], "]"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"4", 
       SuperscriptBox[
        RowBox[{"\[Alpha]Ssol", "[", "\[Mu]", "]"}], "2"]}], 
      RowBox[{"3", 
       SuperscriptBox["Pi", "2"]}]], ",", 
     FractionBox[
      RowBox[{"3", 
       SuperscriptBox[
        RowBox[{"\[Alpha]SU2Lsol", "[", "\[Mu]", "]"}], "2"]}], 
      RowBox[{"8", 
       SuperscriptBox["Pi", "2"]}]], ",", 
     FractionBox[
      RowBox[{"17", 
       SuperscriptBox[
        RowBox[{"\[Alpha]UYsol", "[", "\[Mu]", "]"}], "2"]}], 
      RowBox[{"72", 
       SuperscriptBox["Pi", "2"]}]]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"keysIT", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Keys", "[", 
      RowBox[{"DownValues", "@", "ItIntegrandCoef"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}], "//", 
    "DeleteDuplicates"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vtb", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vts", "=", 
   RowBox[{"41.5", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "3."}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vtd", "=", 
   RowBox[{"8", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"CKMsuppression", "[", "\"\<b->s\>\"", "]"}], ",", 
     RowBox[{"CKMsuppression", "[", "\"\<b->d\>\"", "]"}], ",", 
     RowBox[{"CKMsuppression", "[", "\"\<s->d\>\"", "]"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vtb", "*", "Vts"}], ",", 
     RowBox[{"Vtb", "*", "Vtd"}], ",", 
     RowBox[{"Vts", "*", "Vtd"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FCNCtransitions", "=", 
   RowBox[{
    RowBox[{"Keys", "[", 
     RowBox[{"DownValues", "@", "CKMsuppression"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xtv", "=", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], "2"], 
    SuperscriptBox["80", "2."]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cos\[Theta]W", "=", 
   FractionBox["80", "91."]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FCNCcouplingTemp", "[", 
   RowBox[{"model_", ",", "\[CapitalLambda]_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"value", "[", 
         RowBox[{"ALPcouplingslist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "=", 
        RowBox[{"couplingPattern", "[", 
         RowBox[{"model", ",", 
          RowBox[{"ALPcouplingslist", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "ALPcouplingslist", "]"}], ",", "1"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soltemp", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Mu]", "*", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"RunningCoupling", "[", 
                   RowBox[{"coef", ",", "\[Mu]"}], "]"}], ",", "\[Mu]"}], 
                 "]"}]}], "==", 
               RowBox[{"cXXrunning", "[", 
                RowBox[{"coef", ",", "\[Mu]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"RunningCoupling", "[", 
                RowBox[{"coef", ",", "\[CapitalLambda]"}], "]"}], "==", 
               RowBox[{"c\[CapitalLambda]", "[", 
                RowBox[{"coef", ",", 
                 RowBox[{"value", "[", "\"\<cG\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cW\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cB\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cu\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cd\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cs\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cc\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<cb\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<ct\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<ce\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<c\[Mu]\>\"", "]"}], ",", 
                 RowBox[{"value", "[", "\"\<c\[Tau]\>\"", "]"}]}], "]"}]}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"coef", ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<ct\>\"", ",", "\"\<cB\>\"", ",", "\"\<cW\>\"", ",", 
                "\"\<cG\>\""}], "}"}]}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "0", "]"}], "]"}], "&"}], "/@", 
           RowBox[{"couplingsList", "[", "\[Mu]", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", 
           RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], ",", "\[CapitalLambda]"}],
           "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"runningSol", "[", "coef", "]"}], "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"RunningCoupling", "[", 
            RowBox[{"coef", ",", "\[Mu]"}], "]"}], "[", 
           RowBox[{"[", "0", "]"}], "]"}], "/.", "soltemp"}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"coef", ",", "coefskeys"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"integrandIt", "[", "\[Mu]_", "]"}], "=", 
      RowBox[{
       FractionBox["1", "\[Mu]"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "18"}], "*", 
           RowBox[{"Uval", "[", 
            RowBox[{
             RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], ",", "\[Mu]"}], "]"}]}],
           "]"}]}], ")"}], 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"runningSol", "[", "coef", "]"}], "[", "\[Mu]", "]"}], "*", 
          RowBox[{"ItIntegrandCoef", "[", 
           RowBox[{"coef", ",", "\[Mu]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"coef", ",", "keysIT"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"integralIt", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["2", "3"]}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "18"}], "*", 
            RowBox[{"Uval", "[", 
             RowBox[{
              RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], ",", 
              "\[CapitalLambda]"}], "]"}]}], "]"}]}], ")"}], "2", "*", 
        RowBox[{
         RowBox[{"runningSol", "[", "\"\<ct\>\"", "]"}], "[", 
         "\[CapitalLambda]", "]"}]}], "-", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"integrandIt", "[", "\[Mu]", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[CapitalLambda]", ",", 
           RowBox[{"MASS", "[", "\"\<t\>\"", "]"}]}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "6"], "integralIt"}], "+", 
        RowBox[{
         FractionBox[
          RowBox[{"4", "*", "Pi", "*", 
           RowBox[{"\[Alpha]Tsol", "[", 
            RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], "]"}]}], 
          RowBox[{"16", 
           SuperscriptBox["Pi", "2"]}]], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "*", 
            RowBox[{
             RowBox[{"runningSol", "[", "\"\<ct\>\"", "]"}], "[", 
             RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "4"], "+", 
              RowBox[{
               FractionBox["3", "2"], 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", "xtv", "+", 
                  RowBox[{"Log", "[", "xtv", "]"}]}], ")"}], 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", "xtv"}], ")"}], "2"]]}]}], ")"}]}], "+", 
           RowBox[{
            FractionBox[
             RowBox[{"3", 
              RowBox[{"(", 
               RowBox[{"1", "/", "137"}], ")"}]}], 
             RowBox[{"2", "*", "Pi", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox["cos\[Theta]W", "2"]}], ")"}]}]], "*", 
            RowBox[{"c\[CapitalLambda]", "[", 
             RowBox[{"\"\<cW\>\"", ",", 
              RowBox[{"value", "[", "\"\<cG\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cW\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cB\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cu\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cd\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cs\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cc\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<cb\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<ct\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<ce\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<c\[Mu]\>\"", "]"}], ",", 
              RowBox[{"value", "[", "\"\<c\[Tau]\>\"", "]"}]}], "]"}], "*", 
            FractionBox[
             RowBox[{"(", 
              RowBox[{"1", "-", "xtv", "+", 
               RowBox[{"xtv", "*", 
                RowBox[{"Log", "[", "xtv", "]"}]}]}], ")"}], 
             SuperscriptBox[
              RowBox[{"(", 
