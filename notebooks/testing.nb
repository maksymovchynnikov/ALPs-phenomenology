Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vectors", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", ",", 
     "\"\<\[Omega]\>\"", ",", "\"\<\[Phi]\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleMixingV\[Gamma]", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"d\[Rho]0", "[", 
       RowBox[{"x", ",", "a_", ",", "b_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"d\[Rho]0", "[", 
        RowBox[{"x", ",", "a", ",", "b"}], "]"}], "+", 
       RowBox[{
        RowBox[{"dA", "[", 
         RowBox[{"x", ",", "a", ",", "b"}], "]"}], "*", 
        RowBox[{
        "VA", "[", "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", 
         "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"d\[Omega]", "[", 
       RowBox[{"x", ",", "a_", ",", "b_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"d\[Omega]", "[", 
        RowBox[{"x", ",", "a", ",", "b"}], "]"}], "+", 
       RowBox[{
        RowBox[{"dA", "[", 
         RowBox[{"x", ",", "a", ",", "b"}], "]"}], "*", 
        RowBox[{"VA", "[", "\"\<\[Omega]\>\"", "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"d\[Phi]", "[", 
       RowBox[{"x", ",", "a_", ",", "b_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"d\[Phi]", "[", 
        RowBox[{"x", ",", "a", ",", "b"}], "]"}], "+", 
       RowBox[{
        RowBox[{"dA", "[", 
         RowBox[{"x", ",", "a", ",", "b"}], "]"}], "*", 
        RowBox[{"VA", "[", "\"\<\[Phi]\>\"", "]"}]}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lagrVVP", "[", "u", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"a", "==", "b"}], ",", "1", ",", 
            FractionBox["1", "2"]}], "]"}], "*", 
          RowBox[{"LagrangianGivenFields", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b", ",", "u"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "vectors"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "vectors"}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", "->", "0"}], "}"}]}], "//", "Simplify"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lagrVVP", "[", "u", "]"}], "=", 
     RowBox[{"Refine", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lagrVVP", "[", "u", "]"}], "/.", "ruleMixingV\[Gamma]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]EM", "->", 
           FractionBox[
            SuperscriptBox["e", "2"], 
            RowBox[{"4", "Pi"}]]}], ",", 
          RowBox[{"m\[Rho]plus", "->", 
           RowBox[{
            SqrtBox["2"], "f\[Pi]", "*", "g"}]}]}], "}"}]}], ",", 
       RowBox[{"e", ">", "0"}]}], "]"}]}]}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
       "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\""}], "}"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"couplingV", "[", 
   RowBox[{"meson_", ",", "V_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{
       FractionBox[
        RowBox[{"e", "*", "g"}], "f\[Pi]"], 
       FractionBox["3", 
        RowBox[{"8", 
         SuperscriptBox["Pi", "2"]}]]}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"LagrangianGivenFields1", "[", 
         RowBox[{
          RowBox[{"lagrVVP", "[", "meson", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"meson", ",", "\"\<A\>\"", ",", "V"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "]"}], "//", 
        "Simplify"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"EPSILON", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
         "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"dA", "[", 
            RowBox[{"x", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], "*", 
           RowBox[{"dVfieldSymbol", "[", 
            RowBox[{"V", ",", "x", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}]}],
           "+", 
          RowBox[{
           RowBox[{"dA", "[", 
            RowBox[{"x", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}], "*", 
           RowBox[{"dVfieldSymbol", "[", 
            RowBox[{"V", ",", "x", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}]}], 
         ")"}], 
        RowBox[{"PfieldSymbol", "[", 
         RowBox[{"meson", ",", "x"}], "]"}]}], ")"}]}], ")"}]}], "//", 
   "Cancel"}]}], "\[IndentingNewLine]", 
 RowBox[{"tabCoefs", "=", " ", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "\"\<\>\"", "}"}], ",", "listMesonP0"}], "]"}], "}"}], 
     ",", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"vectors", ",", "1"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"couplingV", "[", 
           RowBox[{"meson", ",", "V"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"meson", ",", "listMesonP0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"V", ",", "vectors"}], "}"}]}], "]"}], "//", "Transpose"}],
        ",", "2"}], "]"}]}], "]"}], "//", 
   "Transpose"}]}], "\[IndentingNewLine]", 
 RowBox[{"tabCoefs", "//", "TeXForm"}]}], "Input",
 CellChangeTimes->{3.968815096963787*^9},
 CellLabel->"In[78]:=",ExpressionUUID->"57bb73f0-c07c-ae42-8542-d6433296d8c1"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"\<\"\"\>", "\<\"\\!\\(\\*SuperscriptBox[\\(\[Rho]\\), \
\\(0\\)]\\)\"\>", "\<\"\[Omega]\"\>", "\<\"\[Phi]\"\>"},
     {"\<\"\\!\\(\\*SuperscriptBox[\\(\[Pi]\\), \\(0\\)]\\)\"\>", 
      FractionBox["1", "6"], 
      FractionBox["1", "2"], "0"},
     {"\<\"\[Eta]\"\>", 
      FractionBox["1", 
       SqrtBox["6"]], 
      FractionBox["1", 
       RowBox[{"3", " ", 
        SqrtBox["6"]}]], 
      FractionBox["1", 
       RowBox[{"3", " ", 
        SqrtBox["3"]}]]},
     {"\<\"\[Eta]'\"\>", 
      FractionBox["1", 
       RowBox[{"2", " ", 
        SqrtBox["3"]}]], 
      FractionBox["1", 
       RowBox[{"6", " ", 
        SqrtBox["3"]}]], 
      RowBox[{"-", 
