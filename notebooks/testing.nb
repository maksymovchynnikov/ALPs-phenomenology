Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{"Mvall", "=", 
   RowBox[{
    FractionBox["f\[Pi]", 
     RowBox[{"9", 
      SqrtBox["2"]}]], "G27", "*", "3", 
    SqrtBox["2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "5"}], 
       SuperscriptBox["mKplus", "2"]}], "+", 
      RowBox[{"5", 
       SuperscriptBox["m\[Pi]plus", "2"]}]}], ")"}], "\[IndentingNewLine]", 
    RowBox[{
     FractionBox["1", 
      FractionBox[
       RowBox[{"6.58", "*", 
        SuperscriptBox["10", 
         RowBox[{"-", "25"}]]}], 
       RowBox[{"1.23", "*", 
        SuperscriptBox["10", 
         RowBox[{"-", "8"}]]}]]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ruleSymbolsToNumbers", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "mKplus"], 
           FractionBox[
            SuperscriptBox["Mvall", "2"], 
            RowBox[{"8", "Pi"}]], "*", 
           FractionBox[
            SqrtBox[
             RowBox[{
              SuperscriptBox["mKplus", "2"], "-", 
              RowBox[{"4", 
               SuperscriptBox["m\[Pi]plus", "2"]}]}]], 
            RowBox[{"2", "*", "mKplus"}]]}], ",", "choiceMixingDescription", 
          ",", "2"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{"G27", "->", 
          RowBox[{"G8", "*", 
           FractionBox["0.29", "5"]}]}], "}"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{"G8", "->", "G8val"}], "}"}]}], ")"}]}]}]}], 
  "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.944931753261446*^9, 3.944931754061428*^9}, {
