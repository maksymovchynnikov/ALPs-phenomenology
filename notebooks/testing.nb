          RowBox[{"Mdecayalp", "[", 
           RowBox[{"\"\<No off-shell\>\"", ",", 
            RowBox[{"particleslist", "[", "process", "]"}], ",", 
            RowBox[{"labelList", "[", "process", "]"}]}], "]"}], ",", 
          "process"}], "]"}], "//", "Simplify"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"melelementExplicit", "[", "process", "]"}], "=", 
       RowBox[{
        RowBox[{"melelement", "[", "process", "]"}], "/.", 
        RowBox[{
        "rulem0aTransformationSymbolicToExplicit", "[", 
         "choiceMixingDescription", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"melement\[Kappa]", "[", "process", "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"melelementExplicit", "[", "process", "]"}], ",", 
               "\[Kappa]u"}], "]"}], "*", "\[Kappa]u"}], "]"}], "+", 
