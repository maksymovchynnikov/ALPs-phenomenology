      RowBox[{"FeynmanRuleVertex0", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\"", ",", 
          "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\"", ",", 
          "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<K\>\"", ",", "\"\<\[Pi]plus\>\"", ",", "\"\<\[Pi]0\>\""}], 
         "}"}]}], "]"}], "\[IndentingNewLine]", "meltemp"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"meltemp", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"ScalarProduct", "[", 
            RowBox[{"pK", ",", "p\[Pi]0"}], "]"}], "->", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["mKplus", "2"], "+", 
              SuperscriptBox["m\[Pi]0", "2"], "-", 
              SuperscriptBox["m\[Pi]plus", "2"]}], ")"}], "2"]}], ",", 
          RowBox[{
           RowBox[{"ScalarProduct", "[", 
            RowBox[{"pK", ",", "p\[Pi]plus"}], "]"}], "->", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["mKplus", "2"], "+", 
              SuperscriptBox["m\[Pi]plus", "2"], "-", 
              SuperscriptBox["m\[Pi]0", "2"]}], ")"}], "2"]}], ",", 
          RowBox[{
           RowBox[{"ScalarProduct", "[", 
            RowBox[{"p\[Pi]0", ",", "p\[Pi]plus"}], "]"}], "->", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["mKplus", "2"], "-", 
              SuperscriptBox["m\[Pi]plus", "2"], "-", 
              SuperscriptBox["m\[Pi]0", "2"]}], ")"}], "2"]}]}], "}"}]}], "//", 
       RowBox[{"Simplify", "\[IndentingNewLine]", "meltemp"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"meltemp", "/.", 
          RowBox[{
          "rulem0aTransformationSymbolicToExplicit", "[", 
           "choiceMixingDescription", "]"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{"\[Delta]", "->", "0"}], "}"}]}], "//", 
        RowBox[{"Simplify", "\[IndentingNewLine]", "WidthTemp"}]}], "=", 
       RowBox[{
        RowBox[{"ruleSymbolsToNumbers", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "mKplus"], 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"meltemp", "*", 
               RowBox[{"Conjugate", "[", "meltemp", "]"}]}], "/.", 
              RowBox[{"{", 
               RowBox[{"m\[Pi]plus", "->", "0.139"}], "}"}]}], ")"}], 
            RowBox[{"8", "Pi"}]], 
           FractionBox[
            RowBox[{"p", "/.", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", 
                  SqrtBox[
                   RowBox[{
                    SuperscriptBox["p", "2"], "+", 
                    SuperscriptBox["m\[Pi]0", "2"]}]]}], "==", "mKplus"}], 
                ",", "p"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], 
            RowBox[{"2", "mKplus"}]]}], ",", "choiceMixingDescription", ",", 
          "2"}], "]"}], "\[IndentingNewLine]", 
        FractionBox["WidthTemp", 
         FractionBox[
          RowBox[{"6.58", "*", 
           SuperscriptBox["10", 
            RowBox[{"-", "25"}]]}], 
          RowBox[{"1.23", "*", 
           SuperscriptBox["10", 
            RowBox[{"-", "8"}]]}]]]}]}]}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]"}]], "Input",
