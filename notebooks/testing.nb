Cell[BoxData[{
 RowBox[{
  RowBox[{"ALPinv", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
        ",", "\"\<auxiliary data\>\"", ",", "\"\<sigma-ALP-set-I.txt\>\""}], 
       "}"}], "]"}], ",", "\"\<Table\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ALPdecayWidthVisibleDat", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
        ",", "\"\<phenomenology\>\"", ",", "\"\<Gluon\>\"", ",", 
        "\"\<decays\>\"", ",", 
        "\"\<Widths-model-Gluon-scale-1000.-GeV.m\>\""}], "}"}], "]"}], ",", 
     "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ALPdecayWidthVisible", "[", 
    RowBox[{"ma_", ",", "fa_"}], "]"}], "=", 
   RowBox[{
    SuperscriptBox["fa", 
     RowBox[{"-", "2"}]], 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ALPdecayWidthVisibleDat", "[", 
           RowBox[{"[", "4", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}], ",", "4"}], "]"}], 
       ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NevALPinvRealistic", "[", 
    RowBox[{"ma_", ",", "m\[Chi]_", ",", "fa_", ",", "g\[Chi]_"}], "]"}], "=", 
   RowBox[{
    SuperscriptBox["fa", 
     RowBox[{"-", "2"}]], 
    SuperscriptBox["10", "17."], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ALPinv", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "//", "Log"}], 
         ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
       RowBox[{"Log", "[", "ma", "]"}], "]"}], "//", "Exp"}], ")"}], "*", 
    RowBox[{"(", 
     FractionBox[
      RowBox[{"\[CapitalGamma]ALPToInv", "[", 
       RowBox[{"ma", ",", "m\[Chi]", ",", "g\[Chi]"}], "]"}], 
      RowBox[{
       RowBox[{"ALPdecayWidthVisible", "[", 
        RowBox[{"ma", ",", "fa"}], "]"}], "+", 
       RowBox[{"\[CapitalGamma]ALPToInv", "[", 
        RowBox[{"ma", ",", "m\[Chi]", ",", "g\[Chi]"}], "]"}]}]], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SensitivityALPinvRealistic", "[", 
    RowBox[{"ma_", ",", "m\[Chi]_", ",", "g\[Chi]_"}], "]"}], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"fa", "/.", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NevALPinvRealistic", "[", 
           RowBox[{"ma", ",", "m\[Chi]", ",", "fa", ",", "g\[Chi]"}], "]"}], "==",
           "2.3"}], ",", "fa"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ")"}], 
    RowBox[{"-", "1"}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9726373664537144`*^9, 3.9726374735847225`*^9}, {
