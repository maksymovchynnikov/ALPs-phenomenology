                                 {"f\[Pi]", "/", "fa"}]}], "]"}]}], "}"}]}], "//", "Simplify"}]}],
                   ";", "\[IndentingNewLine]", RowBox[{RowBox[{"\[CapitalGamma]mesonToInvGluon",
