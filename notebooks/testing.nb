               "M2relationPureChPT", "[", 
                "\"\<\!\(\*SuperscriptBox[\(K\), \(0\)]\)\>\"", "]"}]}], ",", 
              RowBox[{
               SuperscriptBox["mKplus", "2"], "->", 
               RowBox[{
               "M2relationPureChPT", "[", 
                "\"\<\!\(\*SuperscriptBox[\(K\), \(0\)]\)\>\"", "]"}]}], ",", 
              RowBox[{
               SuperscriptBox["m\[Eta]pr", "2"], "->", 
               RowBox[{
               "M2relationPureChPT", "[", "\"\<\[Eta]'\>\"", "]"}]}]}], 
             "}"}]}], "*)"}], "//", "ruleLeadingOrderIsospin"}], "//", 
         "Together"}], "//", "Simplify"}]}]}], "\[IndentingNewLine]", ",", 
