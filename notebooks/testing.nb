Cell[BoxData[{
 RowBox[{
  RowBox[{"lagra", "=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"a", "==", "b"}], ",", "1", ",", 
         FractionBox["1", "2"]}], "]"}], "*", 
       RowBox[{"LagrangianGivenFields", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "\"\<a\>\""}], "}"}], ",", 
         RowBox[{"{", 
