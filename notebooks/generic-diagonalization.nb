  Cell[CellGroupData[
    {Cell[BoxData[{RowBox[{RowBox[{"hfuncToy", "[", RowBox[{"meson_", ",", "mX_"}], "]"}], ":=",
          RowBox[{FractionBox["1", RowBox[{"(", RowBox[{SuperscriptBox["ma", "2"], "-",
                 RowBox[{"Mtoy", "[", RowBox[{"meson", ",", "meson"}], "]"}]}], ")"}]],
            RowBox[{"(", RowBox[{RowBox[{"Mtoy", "[", RowBox[{"\"a\"", ",", "meson"}], "]"}], "-",
                RowBox[{SuperscriptBox["mX", "2"], RowBox[{"Ktoy", "[", RowBox[{"\"a\"", ",",
                      "meson"}], "]"}]}], "+", RowBox[{"Sum", "[", RowBox[{RowBox[{"If", "[",
                      RowBox[{RowBox[{RowBox[{"!", RowBox[{"SameQ", "[", RowBox[{SuperscriptBox[
                                 "mX", "2"], ",", RowBox[{"Mtoy", "[", RowBox[{"mes", ",", "mes"}],
                                 "]"}]}], "]"}]}], "&&", RowBox[{"mes", "!=", "meson"}]}], ",",
                        RowBox[{FractionBox[RowBox[{"Mtoy", "[", RowBox[{"meson", ",", "mes"}],
                             "]"}], RowBox[{SuperscriptBox["mX", "2"], "-", RowBox[{"Mtoy", "[",
                               RowBox[{"mes", ",", "mes"}], "]"}]}]], RowBox[{"(", RowBox[
                             {RowBox[{"Mtoy", "[", RowBox[{"\"a\"", ",", "mes"}], "]"}], "-",
                              RowBox[{SuperscriptBox["mX", "2"], "*", RowBox[{"Ktoy", "[", RowBox[
                                 {"\"a\"", ",", "mes"}], "]"}]}]}], ")"}]}], ",", "0"}], "]"}],
                    ",", RowBox[{"{", RowBox[{"mes", ",", "listMesonP0"}], "}"}]}], "]"}]}],
              ")"}]}]}], "\[IndentingNewLine]",
        RowBox[{RowBox[{RowBox[{"m0aTransformationToy", "[", RowBox[{"\"a\"", ",", "x_"}], "]"}],
            "=", RowBox[{"(", RowBox[{RowBox[{"alp", "[", "x", "]"}], "-", RowBox[{"Sum", "[",
                  RowBox[{RowBox[{RowBox[{"PfieldSymbol", "[", RowBox[{"mes", ",", "x"}], "]"}],
                      "*", RowBox[{"hfuncToy", "[", RowBox[{"mes", ",", SqrtBox[RowBox[{"Mtoy",
                             "[", RowBox[{"mes", ",", "mes"}], "]"}]]}], "]"}]}], ",",
                    RowBox[{"{", RowBox[{"mes", ",", "listMesonP0"}], "}"}]}], "]"}]}], ")"}]}],
          ";"}], "\[IndentingNewLine]",
        RowBox[{RowBox[{RowBox[{"dm0aTransformationToy", "[", RowBox[{"\"a\"", ",", "x_", ",",
                "\[Mu]_"}], "]"}], "=", RowBox[{RowBox[{"D", "[", RowBox[
                 {RowBox[{"m0aTransformationToy", "[", RowBox[{"\"a\"", ",", "x"}], "]"}], ",",
                  "x"}], "]"}], "/.", RowBox[{"Evaluate", "[", RowBox[
                 {"DerivativesReplacementRulePS", "[", "\[Mu]", "]"}], "]"}]}]}], ";"}],
        "\[IndentingNewLine]", RowBox[{"Do", "[", "\[IndentingNewLine]",
          RowBox[{RowBox[{RowBox[{RowBox[{"m0aTransformationToy", "[", RowBox[{"meson", ",",
                    "x_"}], "]"}], "=", RowBox[{"(", RowBox[{RowBox[{"PfieldSymbol", "[",
                      RowBox[{"meson", ",", "x"}], "]"}], "-", RowBox[{"Sum", "[", RowBox[
                       {RowBox[{"If", "[", RowBox[{RowBox[{"meson", "!=", "mes"}], ",", RowBox[
                             {FractionBox[RowBox[{"Mtoy", "[", RowBox[{"meson", ",", "mes"}],
                                 "]"}], RowBox[{RowBox[{"Mtoy", "[", RowBox[{"meson", ",",
                                 "meson"}], "]"}], "-", RowBox[{"Mtoy", "[", RowBox[{"mes", ",",
                                 "mes"}], "]"}]}]], RowBox[{"PfieldSymbol", "[", RowBox[{"mes",
                                 ",", "x"}], "]"}]}], ",", "0"}], "]"}], ",", RowBox[{"{",
                          RowBox[{"mes", ",", "listMesonP0"}], "}"}]}], "]"}], "+",
                    RowBox[{RowBox[{"alp", "[", "x", "]"}], "*", RowBox[{"hfuncToy", "[",
                        RowBox[{"meson", ",", "ma"}], "]"}]}]}], ")"}]}], ";",
              "\[IndentingNewLine]", RowBox[{RowBox[{"dm0aTransformationToy", "[",
                  RowBox[{"meson", ",", "x_", ",", "\[Mu]_"}], "]"}], "=", RowBox[
                 {RowBox[{"D", "[", RowBox[{RowBox[{"m0aTransformationToy", "[", RowBox[{"meson",
                          ",", "x"}], "]"}], ",", "x"}], "]"}], "/.", RowBox[{"Evaluate", "[",
                    RowBox[{"DerivativesReplacementRulePS", "[", "\[Mu]", "]"}], "]"}]}]}], ";",
              "\[IndentingNewLine]", RowBox[{RowBox[{"\[Theta]m0ALPToy", "[", "meson", "]"}], "=",
                RowBox[{"D", "[", RowBox[{RowBox[{"m0aTransformationToy", "[", RowBox[{"meson",
                        ",", "x"}], "]"}], ",", RowBox[{"alp", "[", "x", "]"}]}], "]"}]}]}],
            "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"meson", ",", "listMesonP0"}],
              "}"}]}], "]"}], "\[IndentingNewLine]",
        RowBox[{"Print", "[", "\"Result of the diagonalization of the mass matrix:\"", "]"}],
        "\[IndentingNewLine]", RowBox[{RowBox[{"LmassDiagonalized", "=",
            RowBox[{"(", RowBox[{"Lmass", "/.", RowBox[{"Table", "[", RowBox[
                   {RowBox[{RowBox[{"PfieldSymbol", "[", RowBox[{"field", ",", "x"}], "]"}], "->",
                      RowBox[{"m0aTransformationToy", "[", RowBox[{"field", ",", "x"}], "]"}]}],
                    ",", RowBox[{"{", RowBox[{"field", ",", "listMesonP0a"}], "}"}]}], "]"}]}],
              ")"}]}], ";"}], "\[IndentingNewLine]",
        RowBox[{RowBox[{"Normal", "@", RowBox[{"Series", "[", RowBox[{"LmassDiagonalized", ",",
