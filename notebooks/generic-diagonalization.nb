          "Simplify"}], "\[IndentingNewLine]", RowBox[{"Print", "[",
          "\"Result of the diagonalization of the kinetic matrix:\"", "]"}], "\[IndentingNewLine]",
        RowBox[{RowBox[{"LkineticDiagonalized", "=", RowBox[{RowBox[{"(", RowBox[{"Lkinetic", "/.",
                  RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"dPfieldSymbol", "[", RowBox[
                           {"field", ",", "x", ",", "\[Mu]"}], "]"}], "->", RowBox[
                         {"dm0aTransformationToy", "[", RowBox[{"field", ",", "x", ",", "\[Mu]"}],
                          "]"}]}], ",", RowBox[{"{", RowBox[{"field", ",", "listMesonP0a"}],
                        "}"}]}], "]"}]}], ")"}], "//", "Expand"}]}], ";"}], "\[IndentingNewLine]",
        RowBox[{RowBox[{"Normal", "@", RowBox[{"Series", "[", RowBox[{"LkineticDiagonalized", ",",
