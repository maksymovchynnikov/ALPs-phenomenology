Notebook[
 {Cell[CellGroupData[
    {Cell[BoxData[{RowBox[{RowBox[{"Lkinetic", "=", RowBox[{RowBox[{"Sum", "[",
                RowBox[{RowBox[{FractionBox["1", "2"], SuperscriptBox[RowBox[{"dPfieldSymbol", "[",
                       RowBox[{"field", ",", "x", ",", "\[Mu]"}], "]"}], "2"]}], ",",
                  RowBox[{"{", RowBox[{"field", ",", "listMesonP0a"}], "}"}]}], "]"}], "+",
              RowBox[{"\[Epsilon]", "*", RowBox[{"dalp", "[", RowBox[{"x", ",", "\[Mu]"}], "]"}],
                "*", RowBox[{"Sum", "[", RowBox[{RowBox[{RowBox[{"Kterm", "[", RowBox[{"\"a\"",
                          ",", "field"}], "]"}], "*", RowBox[{"dPfieldSymbol", "[", RowBox[
                         {"field", ",", "x", ",", "\[Mu]"}], "]"}]}], ",", RowBox[{"{",
                      RowBox[{"field", ",", "listMesonP0"}], "}"}]}], "]"}]}]}]}], ";"}],
        "\[IndentingNewLine]", RowBox[{RowBox[{"Lmass", "=",
            RowBox[{RowBox[{"-", RowBox[{"Sum", "[", RowBox[{RowBox[{FractionBox[SuperscriptBox[
                        RowBox[{"msymbolic", "[", "field", "]"}], "2"], "2"], SuperscriptBox[
                       RowBox[{"PfieldSymbol", "[", RowBox[{"field", ",", "x"}], "]"}], "2"]}],
                    ",", RowBox[{"{", RowBox[{"field", ",", "listMesonP0a"}], "}"}]}], "]"}]}],
              "-", RowBox[{"\[Delta]", "*", RowBox[{"\[Pi]0", "[", "x", "]"}], "*",
                RowBox[{"Sum", "[", RowBox[{RowBox[{RowBox[{"Mterm", "[", RowBox[
                         {"\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", ",", "field"}], "]"}],
                      "*", RowBox[{"PfieldSymbol", "[", RowBox[{"field", ",", "x"}], "]"}]}], ",",
                    RowBox[{"{", RowBox[{"field", ",", RowBox[{"{", RowBox[{"\"\[Eta]\"", ",",
                            "\"\[Eta]'\""}], "}"}]}], "}"}]}], "]"}]}], "-", RowBox[{"\[Epsilon]",
                "*", RowBox[{"alp", "[", "x", "]"}], "*", RowBox[{"Sum", "[", RowBox[
                   {RowBox[{RowBox[{"Mterm", "[", RowBox[{"\"a\"", ",", "field"}], "]"}], "*",
                      RowBox[{"PfieldSymbol", "[", RowBox[{"field", ",", "x"}], "]"}]}], ",",
                    RowBox[{"{", RowBox[{"field", ",", "listMesonP0"}], "}"}]}], "]"}]}]}]}],
          ";"}], "\[IndentingNewLine]", RowBox[{"Do", "[", "\[IndentingNewLine]",
          RowBox[{RowBox[{RowBox[{RowBox[{"Mtoy", "[", RowBox[{"f1", ",", "f2"}], "]"}], "=",
                RowBox[{"-", RowBox[{"D", "[", RowBox[{"Lmass", ",", RowBox[{"PfieldSymbol", "[",
                        RowBox[{"f1", ",", "x"}], "]"}], ",", RowBox[{"PfieldSymbol", "[",
                        RowBox[{"f2", ",", "x"}], "]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]",
              RowBox[{RowBox[{"MtoyRed", "[", RowBox[{"f1", ",", "f2"}], "]"}], "=",
                RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"f1", "==", "f2"}], ",", "1", ",",
                      RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{",
                                RowBox[{"f1", ",", "f2"}], "}"}], ",", "\"a\""}], "]"}], ",",
                          FractionBox["1", "\[Epsilon]"], ",", RowBox[{"If", "[", RowBox[
                             {RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{", RowBox[{"f1", ",",
                                 "f2"}], "}"}], ",",
                                 "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\""}], "]"}], ",",
                              FractionBox["1", "\[Delta]"], ",", "1"}], "]"}]}], "]"}]}], "]"}],
                  "*", RowBox[{"Mtoy", "[", RowBox[{"f1", ",", "f2"}], "]"}]}]}], ";",
              "\[IndentingNewLine]", RowBox[{RowBox[{"Ktoy", "[", RowBox[{"f1", ",", "f2"}], "]"}],
                "=", RowBox[{"D", "[", RowBox[{"Lkinetic", ",", RowBox[{"dPfieldSymbol", "[",
                      RowBox[{"f1", ",", "x", ",", "\[Mu]"}], "]"}], ",", RowBox[{"dPfieldSymbol",
                      "[", RowBox[{"f2", ",", "x", ",", "\[Mu]"}], "]"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", RowBox[{RowBox[{"KtoyRed", "[", RowBox[{"f1", ",", "f2"}],
                  "]"}], "=", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"f1", "==", "f2"}], ",",
                      "1", ",", RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[
                             {RowBox[{"{", RowBox[{"f1", ",", "f2"}], "}"}], ",", "\"a\""}], "]"}],
                          ",", RowBox[{"-", FractionBox["1", "\[Epsilon]"]}], ",", "1"}], "]"}]}],
                    "]"}], "*", RowBox[{"Ktoy", "[", RowBox[{"f1", ",", "f2"}], "]"}]}]}], ";"}],
            "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"f1", ",", "listMesonP0a"}], "}"}],
            ",", RowBox[{"{", RowBox[{"f2", ",", "listMesonP0a"}], "}"}]}], "]"}],
        "\[IndentingNewLine]", RowBox[{"Print", "[", "\"Mass matrix:\"", "]"}],
        "\[IndentingNewLine]", RowBox[{"Join", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", "\"\"", "}"}], ",", RowBox[{"{", "\"a\"",
                  "}"}], ",", RowBox[{"{", "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", "}"}],
                ",", RowBox[{"{", "\"\[Eta]\"", "}"}], ",", RowBox[{"{", "\"\[Eta]'\"", "}"}]}],
              "}"}], ",", RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[
                     {"\"a\"", ",", "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", ",",
                      "\"\[Eta]\"", ",", "\"\[Eta]'\""}], "}"}], "}"}], ",",
                RowBox[{"Table", "[", RowBox[{RowBox[{"Mtoy", "[", RowBox[{"particle1", ",",
                        "particle2"}], "]"}], ",", RowBox[{"{", RowBox[{"particle1", ",",
                        "listMesonP0a"}], "}"}], ",", RowBox[{"{", RowBox[{"particle2", ",",
                        "listMesonP0a"}], "}"}]}], "]"}]}], "]"}], ",", "2"}], "]"}],
        "\[IndentingNewLine]", RowBox[{"Print", "[", "\"Kinetic matrix:\"", "]"}],
        "\[IndentingNewLine]", RowBox[{"Join", "[",
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", "\"\"", "}"}], ",", RowBox[{"{", "\"a\"",
                  "}"}], ",", RowBox[{"{", "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", "}"}],
                ",", RowBox[{"{", "\"\[Eta]\"", "}"}], ",", RowBox[{"{", "\"\[Eta]'\"", "}"}]}],
              "}"}], ",", RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[
                     {"\"a\"", ",", "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", ",",
                      "\"\[Eta]\"", ",", "\"\[Eta]'\""}], "}"}], "}"}], ",",
                RowBox[{"Table", "[", RowBox[{RowBox[{"Ktoy", "[", RowBox[{"particle1", ",",
                        "particle2"}], "]"}], ",", RowBox[{"{", RowBox[{"particle1", ",",
                        "listMesonP0a"}], "}"}], ",", RowBox[{"{", RowBox[{"particle2", ",",
                        "listMesonP0a"}], "}"}]}], "]"}]}], "]"}], ",", "2"}], "]"}]}], "Input",
      ExpressionUUID -> "48c43a2b-f8ae-ee44-940b-261c8c2d1ffb"]}, Open]],
