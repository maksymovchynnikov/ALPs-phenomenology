        Cell[CellGroupData[{Cell["Decay widths - when non-trivial dependence on couplings \
factorizes out from the integration", "Subsection", ExpressionUUID ->
             "5be2444b-fbb1-4d4d-bc0d-c9248aef84e7"],
           Cell[BoxData[{RowBox[{RowBox[{"massrange", "=", RowBox[{"Select", "[", RowBox[
                     {RowBox[{"Table", "[", RowBox[{"m", ",", RowBox[{"{", RowBox[{"m", ",", "0",
                              ",", "0.958", ",", "0.005"}], "}"}]}], "]"}], ",", RowBox[
                       {RowBox[{RowBox[{"#", "!=", RowBox[{"MASS", "[",
                              "\"\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\"", "]"}]}], "&&",
                          RowBox[{"#", "!=", RowBox[{"MASS", "[", "\"\[Eta]\"", "]"}]}], "&&",
                          RowBox[{"#", "!=", RowBox[{"MASS", "[", "\"\[Eta]'\"", "]"}]}]}],
                        "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
              RowBox[{RowBox[{"\[CapitalGamma]numericMesonTemp", "[", RowBox[{"3", ",", "meson_",
                    ",", "process_"}], "]"}], ":=", RowBox[{"Block", "[", RowBox[
                   {RowBox[{"{", RowBox[{RowBox[{"m0", "=", RowBox[{"MASS", "[", "meson", "]"}]}],
                        ",", RowBox[{"m1", "=", RowBox[{"MASS", "[", RowBox[{RowBox[{"plistdec",
                                "[", RowBox[{"meson", ",", "process"}], "]"}], "[", RowBox[
                               {"[", "1", "]"}], "]"}], "]"}]}], ",", RowBox[{"m2", "=",
                          RowBox[{"MASS", "[", RowBox[{RowBox[{"plistdec", "[", RowBox[{"meson",
                                 ",", "process"}], "]"}], "[", RowBox[{"[", "2", "]"}], "]"}],
                            "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[
                     {RowBox[{RowBox[{"\[CapitalGamma]numericMesonTemp1", "[", "ma_", "]"}], ":=",
                        RowBox[{"If", "[", RowBox[{RowBox[{"ma", "<", RowBox[{"m0", "-", "m1", "-",
                                "m2"}]}], ",", RowBox[{FractionBox["1", RowBox[{SuperscriptBox[
                                 RowBox[{"(", RowBox[{"2", "Pi"}], ")"}], "3"], "32", "*",
                                 SuperscriptBox["m0", "3"]}]], FractionBox["1", RowBox[{RowBox[
                                 {"nPolarizations", "[", "meson", "]"}], " "}]], RowBox[
                               {"SfactorDecay", "[", RowBox[{"meson", ",", "process"}], "]"}], "*",
                              RowBox[{"NIntegrate", "[", RowBox[{RowBox[
                                 {"M2mesonNumeric3bodyReduced", "[", RowBox[{"meson", ",",
                                 "process", ",", "ma", ",", "m12", ",", "m23"}], "]"}], ",",
                                 RowBox[{"{", RowBox[{"m12", ",", RowBox[{"m12lower", "[", RowBox[
                                 {"m1", ",", "m2"}], "]"}], ",", RowBox[{"m12upper", "[", RowBox[
                                 {"m0", ",", "ma"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                                 {"m23", ",", RowBox[{"m23lower", "[", RowBox[{"m12", ",", "m0",
                                 ",", "m1", ",", "m2", ",", "ma"}], "]"}], ",", RowBox[{"m23upper",
                                 "[", RowBox[{"m12", ",", "m0", ",", "m1", ",", "m2", ",", "ma"}],
                                 "]"}]}], "}"}], ",", RowBox[{"Method", "->", RowBox[{"(*", RowBox[
                                 {"intmethod", "[", "process", "]"}], "*)"}], "method"}]}],
                                "]"}]}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]",
                      RowBox[{"tabulatedwidth", "=", RowBox[{"ParallelTable", "[", RowBox[
                           {RowBox[{"{", RowBox[{"ma", ",", RowBox[{"Quiet", "[", RowBox[
                                 {"\[CapitalGamma]numericMesonTemp1", "[", "ma", "]"}], "]"}]}],
                              "}"}], ",", RowBox[{"{", RowBox[{"ma", ",", "massrange"}], "}"}]}],
                          "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[
                         {RowBox[{"ma", "<", RowBox[{"m0", "-", "m1", "-", "m2"}]}], ",",
                          RowBox[{"Evaluate", "[", RowBox[{RowBox[{"EffectiveCoupling", "[",
                                RowBox[{"meson", ",", "process"}], "]"}], "*", RowBox[{RowBox[
                                 {"Interpolation", "[", RowBox[{"tabulatedwidth", ",", RowBox[
                                 {"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", "]"}]}],
                            "]"}], ",", "0."}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
              "\[IndentingNewLine]", RowBox[{RowBox[{"\[CapitalGamma]numericMesonTemp", "[",
                  RowBox[{"2", ",", "meson_", ",", "process_", ",", "ma_"}], "]"}], ":=",
                RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"m0", "=", RowBox[
                           {"MASS", "[", "meson", "]"}]}], ",", RowBox[{"m1", "=", RowBox[
                           {"MASS", "[", RowBox[{RowBox[{"plistdec", "[", RowBox[{"meson", ",",
                                 "process"}], "]"}], "[", RowBox[{"[", "1", "]"}], "]"}],
                            "]"}]}]}], "}"}], ",", RowBox[{"If", "[", RowBox[{RowBox[{"ma", "<",
                          RowBox[{RowBox[{"MASS", "[", "meson", "]"}], "-", "m1"}]}], ",",
                        RowBox[{"Evaluate", "[", RowBox[{RowBox[{"SfactorDecay", "[", RowBox[
                               {"meson", ",", "process"}], "]"}], FractionBox["1", RowBox[
                              {RowBox[{"nPolarizations", "[", "meson", "]"}], " "}]], "*",
                            FractionBox[RowBox[{"M2mesonNumeric2body", "[", RowBox[{"meson", ",",
                                 "process"}], "]"}], RowBox[{"8", "Pi"}]], FractionBox["1",
                             SuperscriptBox[RowBox[{"MASS", "[", "meson", "]"}], "2"]], RowBox[
                             {"psol2body", "[", RowBox[{"m0", ",", "ma", ",", "m1"}], "]"}]}],
                          "]"}], ",", "0."}], "]"}]}], "]"}]}], "\[IndentingNewLine]",
              RowBox[{RowBox[{"\[CapitalGamma]numericMesonFinSimple", "[", RowBox[{"meson_", ",",
                    "process_", ",", "ma_"}], "]"}], ":=", RowBox[{"If", "[", RowBox[
                   {RowBox[{RowBox[{"Length", "[", RowBox[{"plistdec", "[", RowBox[{"meson", ",",
                            "process"}], "]"}], "]"}], "==", "2"}], ",", "\[IndentingNewLine]",
                    RowBox[{"\[CapitalGamma]numericMesonTemp", "[", RowBox[{"2", ",", "meson", ",",
                        "process", ",", "ma"}], "]"}], "\[IndentingNewLine]", ",",
                    "\[IndentingNewLine]", RowBox[{"\[CapitalGamma]numericMesonTemp", "[",
                      RowBox[{"3", ",", "meson", ",", "process"}], "]"}]}], "\[IndentingNewLine]",
                  "]"}]}], "\[IndentingNewLine]", RowBox[{RowBox[{"BrMesonDecayFactorizableTemp",
                  "[", RowBox[{"meson_", ",", "process_", ",", "ma_"}], "]"}], ":=",
                RowBox[{"Block", "[", RowBox[{RowBox[{"{", "}"}], ",", "\[IndentingNewLine]",
                    FractionBox[RowBox[{"\[CapitalGamma]numericMesonFinSimple", "[", RowBox[
                        {"meson", ",", "process", ",", "ma"}], "]"}], RowBox[{"DECAYWIDTH", "[",
                       "meson", "]"}]]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}],
            "Input", ExpressionUUID -> "b1dfa02c-ad1b-7f49-8199-a5efee2ee6ee"]}, Open]],
        Cell[CellGroupData[{Cell["When no factorization is possible", "Subsection",
            ExpressionUUID -> "1ef58586-683c-f14c-a744-9efac7bbdd7c"],
           Cell[BoxData[{RowBox[{RowBox[{"\[CapitalGamma]numericMesonNonFactorizableTemp", "[",
                  RowBox[{"3", ",", "meson_", ",", "process_", ",", "fa_", ",", "cu_", ",", "cd_",
                    ",", "cs_", ",", "cc_", ",", "cb_", ",", "ct_", ",", "cG_", ",", "ce_", ",",
                    "c\[Mu]_", ",", "c\[Tau]_"}], "]"}], ":=", RowBox[{"Module", "[",
                  RowBox[{RowBox[{"{", RowBox[{RowBox[{"m1", "=", RowBox[{"MASS", "[", RowBox[
                             {RowBox[{"plistdec", "[", RowBox[{"meson", ",", "process"}], "]"}],
                              "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}]}], ",",
                        RowBox[{"m2", "=", RowBox[{"MASS", "[", RowBox[{RowBox[{"plistdec", "[",
                                RowBox[{"meson", ",", "process"}], "]"}], "\[LeftDoubleBracket]",
                              "2", "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[{"m0", "=",
                          RowBox[{"MASS", "[", "meson", "]"}]}], ",", "kernel", ",", "integrand",
                        ",", "width", ",", "tabulatedwidth", ",", "mass", ",", "x", ",", "y"}],
                      "}"}], ",", RowBox[{RowBox[{"kernel", "=", RowBox[{"Compile", "[",
                          RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"mass", ",", "_Real"}],
                                 "}"}], ",", RowBox[{"{", RowBox[{"x", ",", "_Real"}], "}"}], ",",
                                RowBox[{"{", RowBox[{"y", ",", "_Real"}], "}"}]}], "}"}], ",",
                            RowBox[{"Evaluate", "[", RowBox[{"M2mesonNumeric3body", "[", RowBox[
                                 {"meson", ",", "process", ",", "mass", ",", "1", ",", "x", ",",
                                 "y", ",", "cu", ",", "cd", ",", "cs", ",", "cc", ",", "cb", ",",
                                 "ct", ",", "cG", ",", "ce", ",", "c\[Mu]", ",", "c\[Tau]"}],
                                "]"}], "]"}], ",", RowBox[{"RuntimeOptions", "\[Rule]",
                              "\"Quality\""}]}], "]"}]}], ";", RowBox[{RowBox[{"integrand", "[",
                          RowBox[{RowBox[{"massValue_", "?", "NumericQ"}], ",", RowBox[{"xValue_",
                              "?", "NumericQ"}], ",", RowBox[{"yValue_", "?", "NumericQ"}]}],
                          "]"}], ":=", RowBox[{"kernel", "[", RowBox[{"massValue", ",", "xValue",
                            ",", "yValue"}], "]"}]}], ";", RowBox[{RowBox[{"width", "[",
                          RowBox[{"massValue_", "?", "NumericQ"}], "]"}], ":=", RowBox[{"If", "[",
                          RowBox[{RowBox[{"massValue", "<", RowBox[{"m0", "-", "m1", "-", "m2"}]}],
                            ",", FractionBox[RowBox[{RowBox[{"SfactorDecay", "[", RowBox[{"meson",
                                 ",", "process"}], "]"}], " ", RowBox[{"NIntegrate", "[", RowBox[
                                 {RowBox[{"integrand", "[", RowBox[{"massValue", ",", "m12", ",",
                                 "m23"}], "]"}], ",", RowBox[{"{", RowBox[{"m12", ",", RowBox[
                                 {"m12lower", "[", RowBox[{"m1", ",", "m2"}], "]"}], ",", RowBox[
                                 {"m12upper", "[", RowBox[{"m0", ",", "massValue"}], "]"}]}],
                                 "}"}], ",", RowBox[{"{", RowBox[{"m23", ",", RowBox[{"m23lower",
                                 "[", RowBox[{"m12", ",", "m0", ",", "m1", ",", "m2", ",",
                                 "massValue"}], "]"}], ",", RowBox[{"m23upper", "[", RowBox[{"m12",
                                 ",", "m0", ",", "m1", ",", "m2", ",", "massValue"}], "]"}]}],
                                 "}"}], ",", RowBox[{"Method", "\[Rule]", "method"}]}], "]"}]}],
                             RowBox[{RowBox[{"(", RowBox[{SuperscriptBox[RowBox[{"(", RowBox[
                                 {"2", " ", "\[Pi]"}], ")"}], "3"], " ", "32", " ", SuperscriptBox[
                                 "m0", "3"]}], ")"}], " ", RowBox[{"nPolarizations", "[", "meson",
                                 "]"}]}]], ",", "0"}], "]"}]}], ";", RowBox[{"tabulatedwidth", "=",
                        RowBox[{"ParallelTable", "[", RowBox[{RowBox[{"{", RowBox[{"mass", ",",
                                RowBox[{"Quiet", "[", RowBox[{"width", "[", "mass", "]"}], "]"}]}],
                              "}"}], ",", RowBox[{"{", RowBox[{"mass", ",", "massrange"}], "}"}]}],
                          "]"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{"ma", "<", RowBox[
                             {"m0", "-", "m1", "-", "m2"}]}], ",", RowBox[{"Evaluate", "[",
                            FractionBox[RowBox[{RowBox[{"Interpolation", "[", RowBox[
                                 {"tabulatedwidth", ",", RowBox[{"InterpolationOrder", "\[Rule]",
                                 "1"}]}], "]"}], "[", "ma", "]"}], SuperscriptBox["fa", "2"]],
                            "]"}], ",", "0.`"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]",
              RowBox[{RowBox[{"BrMesonDecayNonFactorizable", "[", RowBox[{"meson_", ",",
