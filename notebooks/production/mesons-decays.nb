        RowBox[{"model", ",", "\[CapitalLambda]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     FractionBox[
      RowBox[{"\[CapitalGamma]numericMesonNonFactorizableTemp", "[", 
       RowBox[{
