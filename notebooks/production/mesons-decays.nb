          RowBox[{"(*", 
           RowBox[{"Vertex", " ", 
            SubscriptBox["VX", "2"], 
            SubscriptBox["X", "3"]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"vertVmm", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"FeynmanRuleVertex", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "Vintermediate", ",", "meson1Vmm", ",", "meson2Vmm"}], "}"}],
