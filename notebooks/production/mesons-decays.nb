Cell[CellGroupData[{

Cell["Scalar products replacements", "Subsection",
 CellChangeTimes->{{3.945259472331648*^9, 
  3.9452594756361656`*^9}},ExpressionUUID->"db6db2e2-ddbc-f148-a09d-\
7b2c6d618f78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ruleScalarProductsDecays3body", "[", 
   RowBox[{"expr_", ",", "meson_", ",", "process_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MomListRed", "=", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"momList", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], ",", "1"}], "]"}]}], ",", 
      "pmother", ",", "expr1", ",", 
      RowBox[{"mmother", "=", 
       RowBox[{"msymbolic", "[", "meson", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pmother", "=", 
      RowBox[{
       RowBox[{"momList", "[", 
        RowBox[{"meson", ",", "process"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"expr", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ScalarProduct", "[", 
            RowBox[{"pmother", ",", "pmother"}], "]"}], "->", 
           SuperscriptBox["mmother", "2"]}], "}"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{"pmother", "->", 
          RowBox[{"Total", "[", "MomListRed", "]"}]}], "}"}]}], "//", 
       "ExpandScalarProduct"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"expr1", "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ScalarProduct", "[", 
              RowBox[{
               RowBox[{"MomListRed", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"MomListRed", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "->", 
             RowBox[{"ScalarProduct3body", "[", 
              RowBox[{"i", ",", "j"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "3", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "i", ",", "3", ",", "1"}], "}"}]}], "]"}], 
          "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{"m", "->", "mmother"}], "}"}]}], "/.", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Symbol", "[", 
           RowBox[{"\"\<m\>\"", "<>", 
            RowBox[{"(", 
             RowBox[{"i", "//", "ToString"}], ")"}]}], "]"}], "->", 
          RowBox[{"msymbolic", "[", 
           RowBox[{
            RowBox[{"plistdec", "[", 
             RowBox[{"meson", ",", "process"}], "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "3", ",", "1"}], "}"}]}], "]"}]}]}]}]}],
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleScalarProductsDecays2body", "[", 
   RowBox[{"expr_", ",", "meson_", ",", "process_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pmother", ",", 
      RowBox[{"MomListRed", "=", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"momList", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], ",", "1"}], "]"}]}], ",", 
      "expr1", ",", 
      RowBox[{"mmother", "=", 
       RowBox[{"msymbolic", "[", "meson", "]"}]}], ",", 
      RowBox[{"plist", "=", 
       RowBox[{"plistdec", "[", 
        RowBox[{"meson", ",", "process"}], "]"}]}], ",", "m1", ",", "m2", ",",
       "p1", ",", "p2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], "=", "MomListRed"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pmother", "=", 
      RowBox[{
       RowBox[{"momList", "[", 
        RowBox[{"meson", ",", "process"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m1", ",", "m2"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"msymbolic", "[", 
         RowBox[{"plist", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MomListRed", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"momList", "[", 
         RowBox[{"meson", ",", "process"}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"expr1", "=", 
      RowBox[{"ExpandScalarProduct", "[", 
       RowBox[{
        RowBox[{"expr", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ScalarProduct", "[", 
            RowBox[{"pmother", ",", "pmother"}], "]"}], "->", 
           SuperscriptBox["mmother", "2"]}], "}"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{"pmother", "->", 
          RowBox[{"Total", "[", "MomListRed", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"expr1", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"ScalarProduct", "[", 
          RowBox[{"p1", ",", "p2"}], "]"}], "->", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["mmother", "2"], "-", 
            SuperscriptBox["m1", "2"], "-", 
            SuperscriptBox["m2", "2"]}], ")"}], "2"]}], ",", 
        RowBox[{
         RowBox[{"ScalarProduct", "[", 
          RowBox[{"p1", ",", "p1"}], "]"}], "->", 
         SuperscriptBox["m1", "2"]}], ",", 
        RowBox[{
         RowBox[{"ScalarProduct", "[", 
          RowBox[{"p2", ",", "p2"}], "]"}], "->", 
         SuperscriptBox["m2", "2"]}]}], "}"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9452585392056847`*^9, 3.945258704815687*^9}, {
   3.9452587354272327`*^9, 3.945258738206812*^9}, {3.94525944046542*^9, 
   3.945259462887123*^9}, {3.945259576795025*^9, 3.945259616319031*^9}, {
   3.9452596953217335`*^9, 3.945259756289345*^9}, {3.9452597915341396`*^9, 
   3.9452599367715473`*^9}, {3.945259988859642*^9, 3.945260147113186*^9}, {
   3.945264728463791*^9, 3.94526472869083*^9}, {3.94526533121702*^9, 
   3.945265335752905*^9}, 3.947150214511841*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"c247a88d-7c76-9c46-a539-f75649f2aa9e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Contact terms", "Subsection",
 CellChangeTimes->{{3.945249403986433*^9, 3.9452494065752735`*^9}, {
  3.945330187384796*^9, 
