   RowBox[{
    RowBox[{"MDecayMesonOffShell", "[", 
     RowBox[{"\"\<V off-shell 3-body\>\"", ",", "Vmother_", ",", "process_"}],
      "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mesonlist", "=", 
        RowBox[{"plistdec", "[", 
         RowBox[{"Vmother", ",", "process"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"labellist1", "=", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"labelList", "[", 
           RowBox[{"Vmother", ",", "process"}], "]"}], ",", "1"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"MDecayMesonOffShell", "[", 
          RowBox[{
