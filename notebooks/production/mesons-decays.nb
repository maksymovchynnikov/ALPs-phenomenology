          RowBox[{"mesons", "/", "labels"}]}], " ", "-", " ", 
         RowBox[{
         "two", " ", "from", " ", "the", " ", "S", " ", "propagator", " ", 
          "and", " ", "one", " ", "from", " ", "Sam", " ", "vertex"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"mlist", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"mesonFromPmotherVlist", "[", 
