               "*", 
               RowBox[{"FeynmanRuleVertex", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "Vmother", ",", "Vintermediate", ",", "mesVmotherXV"}], 
                  "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"-", "1"}], ",", 
                   RowBox[{"-", "1"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<0\>\"", ",", "\"\<v\>\"", ",", 
                   RowBox[{
