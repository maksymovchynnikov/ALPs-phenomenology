      ",", "mesonlist_", ",", "labelslist_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mesonlabellist", ",", "mesonsFromPlist", ",", "mesonFromPmotherVlist",
         ",", "mesPmotherXV", ",", "labelslistPmotherXV", ",", 
        "labelslistSmm", ",", "mommes1Smm", ",", "mommes2Smm", ",", 
        "vertPmotherXS", ",", "vertexprop", ",", "vertSmm", ",", "mlist", ",",
