Cell[CellGroupData[{

Cell["\<\
Decay widths - when non-trivial dependence on couplings factorizes out from \
the integration\
\>", "Subsection",
 CellChangeTimes->{{3.945266732618738*^9, 3.9452667591056137`*^9}, {
  3.94526688979846*^9, 
  3.9452668912378216`*^9}},ExpressionUUID->"5be2444b-fbb1-4d4d-bc0d-\
c9248aef84e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"massrange", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"m", ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "0", ",", "0.958", ",", "0.005"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "!=", 
        RowBox[{
        "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", 
         "]"}]}], "&&", 
       RowBox[{"#", "!=", 
        RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}]}], "&&", 
       RowBox[{"#", "!=", 
        RowBox[{"MASS", "[", "\"\<\[Eta]'\>\"", "]"}]}]}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]numericMesonTemp", "[", 
   RowBox[{"3", ",", "meson_", ",", "process_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m0", "=", 
       RowBox[{"MASS", "[", "meson", "]"}]}], ",", 
      RowBox[{"m1", "=", 
       RowBox[{"MASS", "[", 
        RowBox[{
         RowBox[{"plistdec", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"m2", "=", 
       RowBox[{"MASS", "[", 
        RowBox[{
         RowBox[{"plistdec", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalGamma]numericMesonTemp1", "[", "ma_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ma", "<", 
         RowBox[{"m0", "-", "m1", "-", "m2"}]}], ",", 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"2", "Pi"}], ")"}], "3"], "32", "*", 
           SuperscriptBox["m0", "3"]}]], 
         FractionBox["1", 
          RowBox[{
           RowBox[{"nPolarizations", "[", "meson", "]"}], " "}]], 
         RowBox[{"SfactorDecay", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "*", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"M2mesonNumeric3bodyReduced", "[", 
            RowBox[{
            "meson", ",", "process", ",", "ma", ",", "m12", ",", "m23"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m12", ",", 
             RowBox[{"m12lower", "[", 
              RowBox[{"m1", ",", "m2"}], "]"}], ",", 
             RowBox[{"m12upper", "[", 
              RowBox[{"m0", ",", "ma"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m23", ",", 
             RowBox[{"m23lower", "[", 
              RowBox[{"m12", ",", "m0", ",", "m1", ",", "m2", ",", "ma"}], 
              "]"}], ",", 
             RowBox[{"m23upper", "[", 
              RowBox[{"m12", ",", "m0", ",", "m1", ",", "m2", ",", "ma"}], 
              "]"}]}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"(*", 
             RowBox[{"intmethod", "[", "process", "]"}], "*)"}], "method"}]}],
           "]"}]}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tabulatedwidth", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ma", ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"\[CapitalGamma]numericMesonTemp1", "[", "ma", "]"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ma", ",", "massrange"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ma", "<", 
        RowBox[{"m0", "-", "m1", "-", "m2"}]}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"EffectiveCoupling", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "*", 
         RowBox[{
          RowBox[{"Interpolation", "[", 
           RowBox[{"tabulatedwidth", ",", 
            RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", 
          "]"}]}], "]"}], ",", "0."}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]numericMesonTemp", "[", 
   RowBox[{"2", ",", "meson_", ",", "process_", ",", "ma_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m0", "=", 
       RowBox[{"MASS", "[", "meson", "]"}]}], ",", 
      RowBox[{"m1", "=", 
       RowBox[{"MASS", "[", 
        RowBox[{
         RowBox[{"plistdec", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"ma", "<", 
       RowBox[{
        RowBox[{"MASS", "[", "meson", "]"}], "-", "m1"}]}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"SfactorDecay", "[", 
         RowBox[{"meson", ",", "process"}], "]"}], 
        FractionBox["1", 
         RowBox[{
          RowBox[{"nPolarizations", "[", "meson", "]"}], " "}]], "*", 
        FractionBox[
         RowBox[{"M2mesonNumeric2body", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], 
         RowBox[{"8", "Pi"}]], 
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"MASS", "[", "meson", "]"}], "2"]], 
        RowBox[{"psol2body", "[", 
         RowBox[{"m0", ",", "ma", ",", "m1"}], "]"}]}], "]"}], ",", "0."}], 
     "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]numericMesonFinSimple", "[", 
   RowBox[{"meson_", ",", "process_", ",", "ma_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"plistdec", "[", 
       RowBox[{"meson", ",", "process"}], "]"}], "]"}], "==", "2"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\[CapitalGamma]numericMesonTemp", "[", 
     RowBox[{"2", ",", "meson", ",", "process", ",", "ma"}], "]"}], 
    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalGamma]numericMesonTemp", "[", 
     RowBox[{"3", ",", "meson", ",", "process"}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BrMesonDecayFactorizableTemp", "[", 
   RowBox[{"meson_", ",", "process_", ",", "ma_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    FractionBox[
     RowBox[{"\[CapitalGamma]numericMesonFinSimple", "[", 
      RowBox[{"meson", ",", "process", ",", "ma"}], "]"}], 
     RowBox[{"DECAYWIDTH", "[", "meson", "]"}]]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9452438003137646`*^9, 3.945243904990244*^9}, {
