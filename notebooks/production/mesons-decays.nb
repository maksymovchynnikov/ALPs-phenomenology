  3.945266874710663*^9}},ExpressionUUID->"1ef58586-683c-f14c-a744-\
9efac7bbdd7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalGamma]numericMesonNonFactorizableTemp", "[", 
   RowBox[{
   "3", ",", "meson_", ",", "process_", ",", "fa_", ",", "cu_", ",", "cd_", 
    ",", "cs_", ",", "cc_", ",", "cb_", ",", "ct_", ",", "cG_", ",", "ce_", 
    ",", "c\[Mu]_", ",", "c\[Tau]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m1", "=", 
       RowBox[{"MASS", "[", 
        RowBox[{
         RowBox[{"plistdec", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"m2", "=", 
       RowBox[{"MASS", "[", 
        RowBox[{
         RowBox[{"plistdec", "[", 
          RowBox[{"meson", ",", "process"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"m0", "=", 
       RowBox[{"MASS", "[", "meson", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"M2num", "[", 
       RowBox[{"mLLP_", ",", "m12_", ",", "m23_"}], "]"}], "=", 
      RowBox[{"M2mesonNumeric3body", "[", 
       RowBox[{
       "meson", ",", "process", ",", "mLLP", ",", "1", ",", "m12", ",", "m23",
         ",", "cu", ",", "cd", ",", "cs", ",", "cc", ",", "cb", ",", "ct", 
        ",", "cG", ",", "ce", ",", "c\[Mu]", ",", "c\[Tau]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalGamma]numericMesonTemp1", "[", "mLLP_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"mLLP", "<", 
         RowBox[{"m0", "-", "m1", "-", "m2"}]}], ",", 
        RowBox[{"Evaluate", "[", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"2", "Pi"}], ")"}], "3"], "32", "*", 
            SuperscriptBox["m0", "3"]}]], 
          FractionBox["1", 
           RowBox[{
            RowBox[{"nPolarizations", "[", "meson", "]"}], " "}]], 
          RowBox[{"SfactorDecay", "[", 
           RowBox[{"meson", ",", "process"}], "]"}], "*", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"M2num", "[", 
             RowBox[{"mLLP", ",", "m12", ",", "m23"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m12", ",", 
              RowBox[{"m12lower", "[", 
               RowBox[{"m1", ",", "m2"}], "]"}], ",", 
              RowBox[{"m12upper", "[", 
               RowBox[{"m0", ",", "mLLP"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"m23", ",", 
              RowBox[{"m23lower", "[", 
               RowBox[{"m12", ",", "m0", ",", "m1", ",", "m2", ",", "mLLP"}], 
               "]"}], ",", 
              RowBox[{"m23upper", "[", 
               RowBox[{"m12", ",", "m0", ",", "m1", ",", "m2", ",", "mLLP"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"Method", "->", 
             RowBox[{"(*", 
              RowBox[{"intmethod", "[", "process", "]"}], "*)"}], 
             "method"}]}], "]"}]}], "]"}], ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tabulatedwidth", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ma", ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"\[CapitalGamma]numericMesonTemp1", "[", "ma", "]"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ma", ",", "massrange"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ma", "<", 
        RowBox[{"m0", "-", "m1", "-", "m2"}]}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox["fa", "2"]], "*", 
         RowBox[{
          RowBox[{"Interpolation", "[", 
           RowBox[{"tabulatedwidth", ",", 
            RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", 
          "]"}]}], "]"}], ",", "0."}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BrMesonDecayNonFactorizable", "[", 
   RowBox[{
   "meson_", ",", "process_", ",", "ma_", ",", "fa_", ",", "model_", ",", 
    "\[CapitalLambda]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cuval", ",", "cdval", ",", "csval", ",", "ccval", ",", "cbval", ",", 
      "ctval", ",", "cGval", ",", "ceval", ",", "c\[Mu]val", ",", 
      "c\[Tau]val", ",", "cWval", ",", "cBval"}], "}"}], ",", 
