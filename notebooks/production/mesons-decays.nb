                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "//", 
             "ExpandScalarProduct"}]}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"melement2summedpol", "=", "melement2"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "If", " ", "the", " ", "decay", " ", "products", " ", "are", " ", 
          "vectors"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"listMesonV", ",", 
              RowBox[{"mesonlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"melement2summedpol", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"mesonlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<A\>\""}], ",", 
               RowBox[{"DoPolarizationSums", "[", 
                RowBox[{"melement2summedpol", ",", 
                 RowBox[{"momlist", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "0"}], "]"}], 
               ",", 
               RowBox[{"DoPolarizationSums", "[", 
                RowBox[{"melement2summedpol", ",", 
                 RowBox[{"momlist", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], 
              "]"}]}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "mesonlist", "]"}], ",", "1"}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
