           "mesonlist", ",", "labellist1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"V", ",", 
           RowBox[{"Select", "[", 
            RowBox[{"listMesonV", ",", 
             RowBox[{
              RowBox[{"#", "!=", "\"\<A\>\""}], "&"}]}], "]"}]}], "}"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
