                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"coefPheavy", "->", "0"}], ",", 
                RowBox[{"coefVA", "->", "0"}]}], "}"}]}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"FV", "[", 
                RowBox[{
                 RowBox[{"Symbol", "[", 
                  RowBox[{"\"\<p\>\"", "<>", "\"\<v\>\""}], "]"}], ",", 
                 "a_"}], "]"}], ":>", 
               RowBox[{
                RowBox[{"FV", "[", 
                 RowBox[{"mommes1Vmm", ",", "a"}], "]"}], "+", 
                RowBox[{"FV", "[", 
                 RowBox[{"mommes2Vmm", ",", "a"}], "]"}]}]}], "}"}]}], "//", 
            "Contract"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Its", " ", "contraction", " ", "with", " ", "the", " ", 
            "propagator"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"vertexprop", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"vertVmotherXV", "*", 
