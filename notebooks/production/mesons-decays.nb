    "i", " ", "from", " ", "vertex", " ", "times", " ", "i", " ", "from", " ",
      "propagator"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Vpropagator", "[", 
     RowBox[{
     "field_", ",", "p_", ",", "\[Mu]_", ",", "\[Nu]_", ",", "sfunc_"}], 
     "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"MT", "[", 
           RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"FV", "[", 
            RowBox[{"p", ",", "\[Mu]"}], "]"}], "*", 
           RowBox[{"FV", "[", 
            RowBox[{"p", ",", "\[Nu]"}], "]"}]}], 
          SuperscriptBox[
           RowBox[{"msymbolic", "[", "field", "]"}], "2"]]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Mu]"}], "]"}], "*", 
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Mu]"}], "]"}]}], "-", 
         SuperscriptBox[
          RowBox[{"msymbolic", "[", "field", "]"}], "2"], "+", 
         RowBox[{"I", "*", 
          RowBox[{"msymbolic", "[", "field", "]"}], "*", "sfunc", "*", 
          RowBox[{"\[CapitalGamma]symbolic", "[", "field", "]"}]}]}], ")"}]}],
       ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MDecayMesonOffShell", "[", 
     RowBox[{
     "\"\<V off-shell 3-body\>\"", ",", "Vmother_", ",", "Vintermediate_", 
      ",", "mesonlist_", ",", "labelslist_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mesonlabellist", ",", "mesonsFromVlist", ",", "mesonFromVmotherVlist",
         ",", "mesVmotherXV", ",", "labelslistVmotherXV", ",", 
        "labelslistVmm", ",", "mommes1Vmm", ",", "mommes2Vmm", ",", 
        "vertVmotherXV", ",", "vertexprop", ",", "vertVmm", ",", "mlist", ",",
         "Melement", ",", "meson1Vmm", ",", "meson2Vmm", ",", "labellist"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mesonlabellist", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Partition", "[", 
           RowBox[{"mesonlist", ",", "1"}], "]"}], ",", 
          RowBox[{"Partition", "[", 
           RowBox[{"labelslist", ",", "1"}], "]"}], ",", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Unique", " ", "sub"}], "-", 
         RowBox[{
         "sets", " ", "with", " ", "pair", " ", "of", " ", "mesons"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"mesonsFromVlist", "=", 
        RowBox[{"Subsets", "[", 
         RowBox[{"mesonlabellist", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"The", " ", "remaining", " ", "meson", " ", 
         RowBox[{"(", 
          RowBox[{"out", " ", "of", " ", "three"}], ")"}], " ", "for", " ", 
         "the", " ", "unique", " ", "subset"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"mesonFromVmotherVlist", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"mesonlabellist", ",", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"mesonsFromVlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "#"}], "]"}]}], "&"}]}],
            "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "3", ",", "1"}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Melement", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "List", " ", "of", " ", "unique", " ", "combinations", " ", "of", 
          " ", 
          RowBox[{"mesons", "/", "labels"}]}], " ", "-", " ", 
         RowBox[{
         "two", " ", "from", " ", "the", " ", "S", " ", "propagator", " ", 
          "and", " ", "one", " ", "from", " ", "Sam", " ", "vertex"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"mlist", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"mesonFromVmotherVlist", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1", ",", 
             RowBox[{"{", "1", "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"mesonsFromVlist", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], ",", "1"}], "]"}], "]"}], ",", 
          "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"labellist", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"mesonFromVmotherVlist", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"mesonsFromVlist", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], ",", "2"}], "]"}], "]"}], ",", 
          "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
