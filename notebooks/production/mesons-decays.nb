       {Cell["List of all mesons and implemented processes, and final definitions", "Section",
         ExpressionUUID -> "ad9a1a6d-e168-ef4b-9444-a6c57918b2b2"],
        Cell[BoxData[{RowBox[{RowBox[{"listAllDecays", " ", "=", RowBox[
                {RowBox[{RowBox[{RowBox[{RowBox[{"Keys", "[", RowBox[{"DownValues", "@",
                           "SfactorDecay"}], "]"}], "[", RowBox[{"[", RowBox[{"All", ",", "1", ",",
                           "#"}], "]"}], "]"}], "&"}], "/@", RowBox[{"{", RowBox[{"1", ",", "2"}],
                     "}"}]}], "//", "Transpose"}]}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{"listLightMesons", "=", RowBox[{RowBox[{"listAllDecays", "[",
                   RowBox[{"[", RowBox[{"All", ",", "1"}], "]"}], "]"}], "//",
                 "DeleteDuplicates"}]}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[{"\"\[Eta]\"", ",",
                   "\"\!\(\*SuperscriptBox[\(a2\[Pi]\), \(0\)]\)\""}], "]"}], "=",
               "\"Eta-to-ALP-2Pi0\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[{"\"\[Eta]\"", ",",
                   "\"\!\(\*SuperscriptBox[\(a\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \
\(-\)]\)\""}], "]"}], "=", "\"Eta-to-ALP-2PiCh\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[{"\"\[Eta]'\"", ",",
                   "\"\!\(\*SuperscriptBox[\(a2\[Pi]\), \(0\)]\)\""}], "]"}], "=",
               "\"EtaPr-to-ALP-2Pi0\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[{"\"\[Eta]'\"", ",",
                   "\"\!\(\*SuperscriptBox[\(a\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \
\(-\)]\)\""}], "]"}], "=", "\"EtaPr-to-ALP-2PiCh\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[{"\"\[Omega]\"", ",",
                   "\"\!\(\*SuperscriptBox[\(a\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \
\(-\)]\)\""}], "]"}], "=", "\"Omega-to-ALP-2PiCh\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[{"\"\[Omega]\"", ",",
                   "\"a\[Gamma]\""}], "]"}], "=", "\"Omega-to-ALP-gamma\""}], ";"}],
           "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[",
                 RowBox[{"\"\!\(\*SubscriptBox[\(K\), \(S\)]\)\"", ",",
                   "\"\!\(\*SuperscriptBox[\(a\[Pi]\), \(0\)]\)\""}], "]"}], "=",
               "\"KS-to-ALP-Pi0\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{RowBox[{"replacementRuleMesonDecay", "[", RowBox[
                  {"\"\!\(\*SuperscriptBox[\(\[Rho]\), \(+\)]\)\"", ",", "\"\[Pi]a\""}], "]"}],
               "=", "\"RhoCh-to-ALP-PiCh\""}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[
                {RowBox[{RowBox[{RowBox[{"listProcessesMeson", "[", "mes", "]"}], "=",
                     RowBox[{RowBox[{"Select", "[", RowBox[{"listAllDecays", ",", RowBox[
                            {RowBox[{RowBox[{"#", "[", RowBox[{"[", "1", "]"}], "]"}], "==",
                               "mes"}], "&"}]}], "]"}], "[", RowBox[{"[", RowBox[{"All", ",",
                           "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", ",",
                 RowBox[{"{", RowBox[{"mes", ",", "listLightMesons"}], "}"}]}], "]"}], ";"}],
           "\[IndentingNewLine]", RowBox[{RowBox[{"YieldsFromLightMesons", "[", RowBox[
                {"model_", ",", "\[CapitalLambda]_"}], "]"}], ":=", RowBox[{"Block", "[", RowBox[
                {RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", RowBox[
                  {RowBox[{RowBox[{"{", RowBox[{"modval", ",", "lval"}], "}"}], "=",
                     RowBox[{"{", RowBox[{"model", ",", RowBox[{"\[CapitalLambda]", "//", "N"}]}],
                       "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ResourceFunction",
                       "[", "\"MonitorProgress\"", "]"}], "@", RowBox[{"Do", "[",
                       "\[IndentingNewLine]", RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[
                              {"{", RowBox[{RowBox[{"mes", "=", RowBox[{RowBox[{"listAllDecays",
                                 "[", RowBox[{"[", "i", "]"}], "]"}], "[", RowBox[{"[", "1", "]"}],
                                 "]"}]}], ",", RowBox[{"proc", "=", RowBox[{RowBox[
                                 {"listAllDecays", "[", RowBox[{"[", "i", "]"}], "]"}], "[",
                                 RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",",
                             "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[
                                 {"reduceable", "[", RowBox[{"mes", ",", "proc"}], "]"}], ",",
                                 "\[IndentingNewLine]", RowBox[{RowBox[{"BrLightMesons", "[",
                                 RowBox[{"ma_", ",", "fa_", ",", "mes", ",", "proc", ",", "modval",
                                 ",", "lval"}], "]"}], "=", RowBox[{RowBox[
                                 {"BrMesonDecayFactorizable", "[", RowBox[{"mes", ",", "proc", ",",
                                 "ma", ",", "fa", ",", "cu", ",", "cd", ",", "cs", ",", "cc", ",",
                                 "cb", ",", "ct", ",", "cG", ",", "ce", ",", "c\[Mu]", ",",
                                 "c\[Tau]"}], "]"}], "/.", RowBox[{"tableValuesReplacement", "[",
                                 RowBox[{"model", ",", "\[CapitalLambda]"}], "]"}]}]}],
                                 "\[IndentingNewLine]", ",", "\[IndentingNewLine]", RowBox[
                                 {RowBox[{RowBox[{"BrLightMesons", "[", RowBox[{"ma_", ",", "fa_",
                                 ",", "mes", ",", "proc", ",", "modval", ",", "lval"}], "]"}], "=",
                                 RowBox[{"BrMesonDecayNonFactorizable", "[", RowBox[{"mes", ",",
                                 "proc", ",", "ma", ",", "fa", ",", "model", ",",
                                 "\[CapitalLambda]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]",
                               "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",",
                         RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[",
                               "listAllDecays", "]"}], ",", "1"}], "}"}]}], "]"}]}], ";",
                   "\[IndentingNewLine]", RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[
                      {RowBox[{RowBox[{RowBox[{"BrLightMesonsTot", "[", RowBox[{"ma_", ",", "fa_",
                               ",", "mes", ",", "modval", ",", "lval"}], "]"}], "=", RowBox[
                            {"Sum", "[", RowBox[{RowBox[{"BrLightMesons", "[", RowBox[{"ma", ",",
                                 "fa", ",", "mes", ",", "proc", ",", "modval", ",", "lval"}],
                                 "]"}], ",", RowBox[{"{", RowBox[{"proc", ",", RowBox[
                                 {"listProcessesMeson", "[", "mes", "]"}]}], "}"}]}], "]"}]}], ";",
                         "\[IndentingNewLine]", RowBox[{"Do", "[", "\[IndentingNewLine]",
                           RowBox[{RowBox[{RowBox[{RowBox[{"PALPprod", "[", RowBox[{"mes", ",",
                                 "model", ",", "facility", ",", "ma_", ",", "fa_", ",", "lval"}],
                                 "]"}], "=", RowBox[{RowBox[{"\[Chi]Meson", "[", RowBox[{"mes",
                                 ",", "facility"}], "]"}], "*", RowBox[{"BrLightMesonsTot", "[",
                                 RowBox[{"ma", ",", "fa", ",", "mes", ",", "modval", ",", "lval"}],
                                 "]"}]}]}], ";"}], "\[IndentingNewLine]", ",", RowBox[{"{",
                               RowBox[{"facility", ",", "listFacility"}], "}"}]}], "]"}]}],
                       "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"mes", ",",
                           "listLightMesons"}], "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]",
               "]"}]}], "\[IndentingNewLine]"}], "Input", ExpressionUUID ->
          "71261dbf-ee2a-6242-b5e5-f8c94870843d"],
