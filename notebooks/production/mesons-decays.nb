Cell[CellGroupData[{

Cell["\<\
List of all mesons and implemented processes, and final definitions\
\>", "Section",
 CellChangeTimes->{{3.945269920848387*^9, 
  3.945269929356695*^9}},ExpressionUUID->"ad9a1a6d-e168-ef4b-9444-\
a6c57918b2b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"listAllDecays", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Keys", "[", 
        RowBox[{"DownValues", "@", "SfactorDecay"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "//", "Transpose"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listLightMesons", "=", 
   RowBox[{
    RowBox[{"listAllDecays", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "DeleteDuplicates"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\[Eta]\>\"", ",", 
     "\"\<\!\(\*SuperscriptBox[\(a2\[Pi]\), \(0\)]\)\>\""}], "]"}], "=", 
   "\"\<Eta-to-ALP-2Pi0\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\[Eta]\>\"", ",", 
     "\"\<\!\(\*SuperscriptBox[\(a\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(-\)]\)\>\""}], "]"}], "=", "\"\<Eta-to-ALP-2PiCh\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\[Eta]'\>\"", ",", 
     "\"\<\!\(\*SuperscriptBox[\(a2\[Pi]\), \(0\)]\)\>\""}], "]"}], "=", 
   "\"\<EtaPr-to-ALP-2Pi0\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\[Eta]'\>\"", ",", 
     "\"\<\!\(\*SuperscriptBox[\(a\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(-\)]\)\>\""}], "]"}], "=", "\"\<EtaPr-to-ALP-2PiCh\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\[Omega]\>\"", ",", 
     "\"\<\!\(\*SuperscriptBox[\(a\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(-\)]\)\>\""}], "]"}], "=", "\"\<Omega-to-ALP-2PiCh\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{"\"\<\[Omega]\>\"", ",", "\"\<a\[Gamma]\>\""}], "]"}], "=", 
   "\"\<Omega-to-ALP-gamma\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\!\(\*SubscriptBox[\(K\), \(S\)]\)\>\"", ",", 
     "\"\<\!\(\*SuperscriptBox[\(a\[Pi]\), \(0\)]\)\>\""}], "]"}], "=", 
   "\"\<KS-to-ALP-Pi0\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{
    "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(+\)]\)\>\"", ",", 
     "\"\<\[Pi]a\>\""}], "]"}], "=", "\"\<RhoCh-to-ALP-PiCh\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"listProcessesMeson", "[", "mes", "]"}], "=", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"listAllDecays", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "mes"}], "&"}]}], "]"}], 
       "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"mes", ",", "listLightMesons"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YieldsFromLightMesons", "[", 
   RowBox[{"model_", ",", "\[CapitalLambda]_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"modval", ",", "lval"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"model", ",", 
        RowBox[{"\[CapitalLambda]", "//", "N"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mes", "=", 
             RowBox[{
              RowBox[{"listAllDecays", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"proc", "=", 
             RowBox[{
              RowBox[{"listAllDecays", "[", 
