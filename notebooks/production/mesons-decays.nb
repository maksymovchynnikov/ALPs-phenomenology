           RowBox[{"element", ":", " ", "\[CapitalMu]"}]}], " ", "=", " ", 
          RowBox[{
           SubscriptBox["\[CapitalSigma]", 
            RowBox[{"{", "ijk", "}"}]], 
           SubscriptBox["G", 
            RowBox[{
             SubscriptBox["V", "mother"], "iV"}]], " ", 
           FractionBox["1", 
            RowBox[{
             SubscriptBox[
              SuperscriptBox["p", "2"], "V"], "-", 
             SubscriptBox[
              SuperscriptBox["m", "2"], "V"], "-", 
             RowBox[{
              SubscriptBox["im", "V"], 
              SubscriptBox["\[CapitalGamma]", "V"]}]}]], 
           SubscriptBox["G", "Vjk"]}]}], ",", " ", 
         RowBox[{"where", " ", "G", " ", "is", " ", "the", " ", "vertex"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"The", " ", "decay", " ", "product", " ", 
           SubscriptBox["X", "1"], " ", "from", " ", "the", " ", "vertex", 
           " ", 
           SubscriptBox["V", "mother"], 
           SubscriptBox["VX", "1"]}], ",", " ", 
          RowBox[{"and", " ", "the", " ", "corresponding", " ", "labels"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"mesVmotherXV", "=", 
           RowBox[{
            RowBox[{"mlist", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"labelslistVmotherXV", "=", 
           RowBox[{"{", 
            RowBox[{"\"\<0\>\"", ",", "\"\<v\>\"", ",", 
             RowBox[{
              RowBox[{"labellist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "The", " ", "decay", " ", "products", " ", "from", " ", "the", 
             " ", "vertex", " ", 
             SubscriptBox["VX", "2"], 
             SubscriptBox["X", "3"]}], ",", " ", 
            RowBox[{
            "corresponding", " ", "labels", " ", "and", " ", "momenta"}]}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"meson1Vmm", ",", "meson2Vmm"}], "}"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"mlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"labelslistVmm", "=", 
           RowBox[{"{", 
            RowBox[{"\"\<V\>\"", ",", 
             RowBox[{
              RowBox[{"labellist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"labellist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"mommes1Vmm", "=", 
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<p\>\"", "<>", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"labelslistVmm", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "//", "ToString"}], ")"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"mommes2Vmm", "=", 
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<p\>\"", "<>", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"labelslistVmm", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "//", "ToString"}], ")"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Vertex", " ", 
            SubscriptBox["V", "mother"], 
            SubscriptBox["VX", "1"]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"vertVmotherXV", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
