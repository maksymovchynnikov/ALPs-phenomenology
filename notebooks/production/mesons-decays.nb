Cell[BoxData[{
 RowBox[{
  RowBox[{"MdecayMesonContact", "[", 
   RowBox[{"DecayingMeson_", ",", "mesonlist_", ",", "labellist_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"partlistgiven", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "DecayingMeson", "}"}], ",", "mesonlist"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"inlistgiven", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"Length", "[", "mesonlist", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"labelslistgiven", "=", "labellist"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vertexBeforeContraction", "=", 
      RowBox[{
       RowBox[{"Refine", "[", 
        RowBox[{
         RowBox[{"FeynmanRuleVertex0", "[", 
          RowBox[{
          "partlistgiven", ",", "inlistgiven", ",", "labelslistgiven"}], 
          "]"}], ",", 
         RowBox[{"ma", "<", "m\[Eta]pr"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cvmd", "->", "1"}], ",", 
         RowBox[{"coefPheavy", "->", "0"}], ",", 
         RowBox[{"coefVA", "->", "0"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PolarizationContractor", "[", 
      RowBox[{
      "vertexBeforeContraction", ",", "partlistgiven", ",", 
       "labelslistgiven"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleKinematicsDecays", "[", 
   RowBox[{"expr_", ",", "meson_", ",", "process_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"plistdec", "[", 
       RowBox[{"meson", ",", "process"}], "]"}], "]"}], "==", "3"}], ",", 
    RowBox[{"ruleScalarProductsDecays3body", "[", 
     RowBox[{"expr", ",", "meson", ",", "process"}], "]"}], ",", 
    RowBox[{"ruleScalarProductsDecays2body", "[", 
     RowBox[{"expr", ",", "meson", ",", "process"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M2decayMesonContact", "[", 
   RowBox[{"DecayingMeson_", ",", "proc_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"mesonlist", "=", 
        RowBox[{"plistdec", "[", 
         RowBox[{"DecayingMeson", ",", "proc"}], "]"}]}], ",", 
       RowBox[{"labellist", "=", 
        RowBox[{"labelList", "[", 
         RowBox[{"DecayingMeson", ",", "proc"}], "]"}]}]}], "*)"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mesonlist", "=", 
      RowBox[{"plistdec", "[", 
       RowBox[{"DecayingMeson", ",", "proc"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"labellist", "=", 
      RowBox[{"labelList", "[", 
       RowBox[{"DecayingMeson", ",", "proc"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"momlist", "=", 
      RowBox[{"momList", "[", 
       RowBox[{"DecayingMeson", ",", "proc"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mElement", "[", 
       RowBox[{"DecayingMeson", ",", "proc"}], "]"}], "=", 
      RowBox[{
       RowBox[{"MdecayMesonContact", "[", 
        RowBox[{"DecayingMeson", ",", "mesonlist", ",", "labellist"}], "]"}], 
       "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cvmd", "->", "1"}], ",", 
         RowBox[{"coefPheavy", "->", "0"}], ",", 
         RowBox[{"coefVA", "->", "0"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"listMesonV", ",", "DecayingMeson"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"melement2", "=", 
         RowBox[{
          RowBox[{"mElement", "[", 
           RowBox[{"DecayingMeson", ",", "proc"}], "]"}], "*", 
          RowBox[{"ComplexConjugate", "[", 
           RowBox[{"mElement", "[", 
            RowBox[{"DecayingMeson", ",", "proc"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"melement2", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"DoPolarizationSums", "[", 
            RowBox[{"melement2", ",", 
             RowBox[{"momlist", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "//", 
           "ExpandScalarProduct"}], "//", "Simplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"listMesonV", ",", 
              RowBox[{"mesonlist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"melement2", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"mesonlist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<A\>\""}], ",", 
               RowBox[{"DoPolarizationSums", "[", 
                RowBox[{"melement2", ",", 
                 RowBox[{"momlist", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "0"}], "]"}], 
               ",", 
               RowBox[{"DoPolarizationSums", "[", 
                RowBox[{"melement2", ",", 
                 RowBox[{"momlist", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], 
              "]"}]}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "mesonlist", "]"}], ",", "1"}], "}"}]}], 
         "]"}]}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"melement2", "=", 
         RowBox[{
          RowBox[{"mElement", "[", 
           RowBox[{"DecayingMeson", ",", "proc"}], "]"}], "*", 
          RowBox[{"ComplexConjugate", "[", 
           RowBox[{"mElement", "[", 
            RowBox[{"DecayingMeson", ",", "proc"}], "]"}], "]"}]}]}], ";"}]}],
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"melement2", "=", 
      RowBox[{
       RowBox[{"ruleKinematicsDecays", "[", 
        RowBox[{"melement2", ",", "DecayingMeson", ",", "proc"}], "]"}], "//",
        "Simplify"}]}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.945243533089382*^9, 3.945243582927683*^9}, {
