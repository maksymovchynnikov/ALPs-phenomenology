Cell[CellGroupData[{

Cell["Yields of different mesons at facilities", "Section",
 CellChangeTimes->{{3.9452431770892277`*^9, 
  3.9452431825490627`*^9}},ExpressionUUID->"b7d997b9-3a0e-ec48-8a6a-\
565cffdd6b7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LightMesonsYield", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}],
           "//", "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
         "\"\<external data\>\"", ",", "\"\<YieldMesons.mx\>\""}], "}"}], 
       "]"}], ",", "\"\<MX\>\""}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
      "\"\<Rho0\>\"", "->", 
       "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\""}], ",", 
      RowBox[{"\"\<Omega\>\"", "->", "\"\<\[Omega]\>\""}], ",", 
      RowBox[{"\"\<Eta\>\"", "->", "\"\<\[Eta]\>\""}], ",", 
      RowBox[{"\"\<EtaPr\>\"", "->", "\"\<\[Eta]'\>\""}], ",", 
      RowBox[{"\"\<Phi\>\"", "->", "\"\<\[Phi]\>\""}], ",", 
      RowBox[{
      "\"\<Pi0\>\"", "->", 
       "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\""}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"facilitiesYields", "=", 
   RowBox[{"LightMesonsYield", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fac", ",", "mes"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fac", ",", "mes"}], "}"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"LightMesonsYield", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Chi]Meson", "[", 
         RowBox[{"mes", ",", "fac"}], "]"}], "=", 
        RowBox[{
         RowBox[{"LightMesonsYield", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "LightMesonsYield", "]"}], ",", "1"}], "}"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Chi]Meson", "[", 
      RowBox[{
      "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(+\)]\)\>\"", ",", "fac"}], 
      "]"}], "=", 
     RowBox[{
      RowBox[{"\[Chi]Meson", "[", 
       RowBox[{
       "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(-\)]\)\>\"", ",", "fac"}], 
       "]"}], "=", 
      RowBox[{"\[Chi]Meson", "[", 
       RowBox[{
       "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", ",", "fac"}], 
       "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Temporary", " ", "assignments"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Chi]Meson", "[", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(K\), \(S\)]\)\>\"", ",", "fac"}], 
      "]"}], "=", 
     RowBox[{"\[Chi]Meson", "[", 
      RowBox[{"\"\<\[Eta]\>\"", ",", "fac"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Chi]Meson", "[", 
      RowBox[{"\"\<\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\"", ",", "fac"}], 
      "]"}], "=", "0."}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"fac", ",", "facilitiesYields"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9452431899410343`*^9, 3.945243190414772*^9}, {
   3.9452432249077206`*^9, 3.945243245778528*^9}, 3.9452432914616337`*^9, {
   3.945247035483038*^9, 3.945247113488491*^9}, {3.94527328487706*^9, 
