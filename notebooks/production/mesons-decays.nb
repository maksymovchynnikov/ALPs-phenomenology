              SubscriptBox["im", "V"], 
              SubscriptBox["\[CapitalGamma]", "V"]}]}]], 
           SubscriptBox["G", "Vjk"]}]}], ",", " ", 
         RowBox[{"where", " ", "G", " ", "is", " ", "the", " ", "vertex"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
