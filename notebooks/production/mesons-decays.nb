             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], ",", "1"}], "]"}], "]"}], ",", 
          "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"labellist", "=", 
