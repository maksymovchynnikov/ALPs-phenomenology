                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", "labelslistVmm"}], "]"}], 
              "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"coefPheavy", "->", "0"}], ",", 
                RowBox[{"coefVA", "->", "0"}]}], "}"}]}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"FV", "[", 
                RowBox[{
                 RowBox[{"Symbol", "[", 
