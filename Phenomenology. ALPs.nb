Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\<ALP-meson mixing angles (here, assuming the standard replacement for \
the \[Kappa] matrix \[Kappa] = \!\(\*SubscriptBox[SuperscriptBox[\(m\), \
\(-1\)], \(q\)]\)/Tr[\!\(\*SubscriptBox[SuperscriptBox[\(m\), \(-1\)], \(q\)]\
\)]:\>\"", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Numeric", " ", "expressions", " ", "for", " ", "the", " ", "mixing", " ",
      "angles"}], " ", "-", " ", 
    RowBox[{
    "multiplied", " ", "with", " ", "the", " ", "ChPT", " ", 
     "suppression"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]m0a", "[", 
      RowBox[{
      "model", ",", "\[CapitalLambda]_", ",", "meson", ",", "ma_", ",", 
       "fa_"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Ffunction", "[", "ma", "]"}], "*", 
       RowBox[{"ruleSymbolsToNumbersFinal", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]m0ALP", "[", 
           RowBox[{"meson", ",", "choiceMixingDescription"}], "]"}], "/.", 
          "replacement\[Kappa]"}], ",", "2"}], "]"}]}], "/.", 
      RowBox[{"Evaluate", "[", 
       RowBox[{"tableValuesReplacement", "[", 
        RowBox[{"model", ",", "\[CapitalLambda]"}], "]"}], "]"}]}]}], ";"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]m0a", "[", 
      RowBox[{
      "model", ",", "\[CapitalLambda]_", ",", "meson", ",", "ma_", ",", 
       "fa_"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Ffunction", "[", "ma", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ruleSymbolsToNumbersFlexible", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Theta]m0ALP", "[", 
             RowBox[{"meson", ",", "choiceMixingDescription"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cG", "->", "0"}], "}"}]}], ",", 
           "choiceMixingDescription", ",", "1", ",", "False", ",", "True"}], 
          "]"}], "+", 
         RowBox[{"cG", "*", 
          RowBox[{"ruleSymbolsToNumbersFlexible", "[", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Theta]m0ALP", "[", 
               RowBox[{"meson", ",", "choiceMixingDescription"}], "]"}], ",", 
              "cG"}], "]"}], ",", "choiceMixingDescription", ",", "1", ",", 
            "False", ",", "True"}], "]"}]}]}], ")"}]}], "/.", 
      RowBox[{"Evaluate", "[", 
       RowBox[{"tableValuesReplacement", "[", 
        RowBox[{"model", ",", "\[CapitalLambda]"}], "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]2m0a", "[", 
      RowBox[{
      "model", ",", "\[CapitalLambda]_", ",", "meson", ",", "ma_", ",", 
       "fa_"}], "]"}], "=", 
     SuperscriptBox[
      RowBox[{"Abs", "[", 
       RowBox[{"\[Theta]m0a", "[", 
        RowBox[{
        "model", ",", "\[CapitalLambda]", ",", "meson", ",", "ma", ",", 
         "fa"}], "]"}], "]"}], "2"]}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"meson", ",", "listMesonP0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"model", ",", "ModelListAll"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fval", "=", 
   SuperscriptBox["10", "6"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]val", "=", 
   SuperscriptBox["10", "3"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotmixingangles", "[", "model_", "]"}], ":=", 
  RowBox[{"LogLogPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]2m0a", "[", 
          RowBox[{
          "model", ",", "\[CapitalLambda]val", ",", "#", ",", "ma", ",", 
           "fval"}], "]"}], "&"}], "/@", "listMesonP0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]2m0a", "[", 
          RowBox[{"model", ",", 
           RowBox[{"MASS", "[", "\"\<t\>\"", "]"}], ",", "#", ",", "ma", ",", 
           "fval"}], "]"}], "&"}], "/@", "listMesonP0"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["10", "30"], 
          RowBox[{"UnitStep", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
              "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"",
                "]"}], "+", "0.003"}], ")"}], "-", "ma"}], "]"}], "*", 
          RowBox[{"UnitStep", "[", 
           RowBox[{"ma", "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
              "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"",
                "]"}], "-", "0.003"}], ")"}]}], "]"}]}], ",", 
         RowBox[{
          SuperscriptBox["10", "30"], 
          RowBox[{"UnitStep", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}], "+", "0.01"}], 
             ")"}], "-", "ma"}], "]"}], "*", 
          RowBox[{"UnitStep", "[", 
           RowBox[{"ma", "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}], "-", "0.01"}], 
             ")"}]}], "]"}]}], ",", 
         RowBox[{
          SuperscriptBox["10", "10"], 
          RowBox[{"UnitStep", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"MASS", "[", "\"\<\[Eta]'\>\"", "]"}], "+", "0.016"}], 
             ")"}], "-", "ma"}], "]"}], "*", 
          RowBox[{"UnitStep", "[", 
           RowBox[{"ma", "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"MASS", "[", "\"\<\[Eta]'\>\"", "]"}], "-", "0.016"}], 
             ")"}]}], "]"}]}]}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"ma", ",", "0.05", ",", "3"}], "}"}], ",", 
    RowBox[{"PlotPoints", "->", "500"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", " ", 
         RowBox[{"Darker", "@", "Red"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", 
         RowBox[{"Darker", "@", 
          RowBox[{"Darker", "@", "Green"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue", ",", 
         RowBox[{"Dashing", "[", "0.02", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", " ", 
         RowBox[{"Darker", "@", "Red"}], ",", 
         RowBox[{"Dashing", "[", "0.02", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", 
         RowBox[{"Darker", "@", 
          RowBox[{"Darker", "@", "Green"}]}], ",", 
         RowBox[{"Dashing", "[", "0.02", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Black"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", 
         RowBox[{"Darker", "@", "Green"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", 
         RowBox[{"Darker", "@", "Green"}], ",", 
