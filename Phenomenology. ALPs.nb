Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabcoeffsExport", "[", "mLLP_", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\"\<[(\!\(\*SubscriptBox[\(\[Sigma]\), \
\(DIS\)]\)/\!\(\*SubscriptBox[\(\[Sigma]\), \(DIS\)]\)) \
|\!\(\*SubscriptBox[\(c\), \(G, eff\)]\)\!\(\*SuperscriptBox[\(|\), \
\(2\)]\)\!\(\*SubscriptBox[\(]\), \(\[Epsilon] = 1\)]\)\>\"", ",", 
       SuperscriptBox[
        RowBox[{"Abs", "[", 
         FractionBox[
          RowBox[{"cGval", "[", 
           RowBox[{
           "mLLP", ",", "modelChoice", ",", "\[CapitalLambda]Choice"}], "]"}],
           "F\[Pi]"], "]"}], "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<|\!\(\*SubscriptBox[\(\[Theta]\), \(\*SuperscriptBox[\(\[Pi]\), \
\(0\)] a\)]\)\!\(\*SuperscriptBox[\(|\), \(2\)]\) (\[Epsilon] = 1)\>\"", ",", 
       RowBox[{"\[Theta]2m0a", "[", 
        RowBox[{
        "modelChoice", ",", "\[CapitalLambda]Choice", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", "mLLP", ",",
          "F\[Pi]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<|\!\(\*SubscriptBox[\(\[Theta]\), \
\(\[Eta]a\)]\)\!\(\*SuperscriptBox[\(|\), \(2\)]\) (\[Epsilon] = 1)\>\"", ",", 
