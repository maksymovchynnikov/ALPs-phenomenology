           RowBox[{"proc", ",", "DecayProcessesList"}], "}"}]}], "]"}], ",", 
        "\"\<MX\>\""}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"numproducts", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"particleslist", "[", "pr", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"numproducts", "==", "2"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"M2numeric2body", "[", 
            RowBox[{
            "pr", ",", "ma_", ",", "fa_", ",", "cu_", ",", "cd_", ",", "cs_", 
             ",", "cc_", ",", "cb_", ",", "ct_", ",", "cG_", ",", 
             "c\[Gamma]_", ",", "ce_", ",", "c\[Mu]_", ",", "c\[Tau]_"}], 
            "]"}], "=", 
           RowBox[{
            RowBox[{"symbolsToNumbersWidths", "[", 
             RowBox[{"M2symbolic2body", "[", "pr", "]"}], "]"}], "*", 
            SuperscriptBox[
             RowBox[{"Ffunction", "[", "ma", "]"}], "2"]}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"numproducts", "==", "3"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"M2numeric3body", "[", 
            RowBox[{
            "pr", ",", "ma_", ",", "fa_", ",", "cu_", ",", "cd_", ",", "cs_", 
             ",", "cc_", ",", "cb_", ",", "ct_", ",", "cG_", ",", 
             "c\[Gamma]_", ",", "ce_", ",", "c\[Mu]_", ",", "c\[Tau]_", ",", 
             "m12_", ",", "m23_"}], "]"}], "=", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"MemberQ", "[", 
                RowBox[{"proclist3\[Pi]", ",", "pr"}], "]"}]}], ",", 
              RowBox[{"symbolsToNumbersWidths", "[", 
               RowBox[{"M2symbolic3body", "[", "pr", "]"}], "]"}], ",", 
              RowBox[{"symbolsToNumbersWidths3\[Pi]", "[", 
               RowBox[{"M2symbolic3body", "[", "pr", "]"}], "]"}]}], "]"}], 
            "*", 
            SuperscriptBox[
             RowBox[{"Ffunction", "[", "ma", "]"}], "2"]}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"numproducts", "==", "4"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"M2numeric4body", "[", 
           RowBox[{
           "pr", ",", "ma_", ",", "fa_", ",", "cu_", ",", "cd_", ",", "cs_", 
            ",", "cc_", ",", "cb_", ",", "ct_", ",", "cG_", ",", "c\[Gamma]_",
             ",", "ce_", ",", "c\[Mu]_", ",", "c\[Tau]_", ",", "s12_", ",", 
            "s34_", ",", "\[Theta]1_", ",", "\[Theta]3_", ",", "\[Phi]3_"}], 
           "]"}], "=", 
          RowBox[{
           RowBox[{"symbolsToNumbersWidths", "[", 
            RowBox[{"ruleKinematics", "[", 
             RowBox[{
              RowBox[{"M2symbolic4body", "[", "pr", "]"}], ",", "pr"}], "]"}],
             "]"}], "*", 
           SuperscriptBox[
            RowBox[{"Ffunction", "[", "ma", "]"}], "2"]}]}]}], "]"}], ";"}], 
