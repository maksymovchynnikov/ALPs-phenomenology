             RowBox[{"crgval", "[", "\"\<c\[Mu]\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<c\[Tau]\>\"", "]"}]}], "]"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"ma", ",", "marange1"}], "}"}]}], "]"}], ",", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{"\[CapitalGamma]list", "[", 
            RowBox[{"ma", ",", "fa", ",", 
             RowBox[{"crgval", "[", "\"\<cu\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cd\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cs\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cc\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cb\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<ct\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cG\>\"", "]"}], ",", 
             RowBox[{"c\[Gamma]glued", "[", "ma", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<ce\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<c\[Mu]\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<c\[Tau]\>\"", "]"}]}], "]"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"ma", ",", "marange2"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "total", " ", "width", " ", "of", " ", "the", " ", 
       "processes", " ", "belonging", " ", "to", " ", "the", " ", "given", 
       " ", "class"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalGamma]list1", "[", "proc", "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Total", "[", "#", "]"}], "}"}], "&"}], "/@", 
