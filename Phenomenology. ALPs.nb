             RowBox[{"crgval", "[", "\"\<cu\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cd\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cs\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cc\>\"", "]"}], ",", 
             RowBox[{"crgval", "[", "\"\<cb\>\"", "]"}], ",", 
