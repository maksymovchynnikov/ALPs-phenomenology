           "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
            "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\""}], "}"}]}], ",", "#"}], 
        "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prodProbListTemp", "[", "ma_", "]"}], "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "ma", "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"PALPprod", "[", 
        RowBox[{
        "#", ",", "modelChoice", ",", "facilityChoice", ",", "ma", ",", "1.", 
         ",", "\[CapitalLambda]choice"}], "]"}], "&"}], "/@", 
      "ProductionChannels"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
