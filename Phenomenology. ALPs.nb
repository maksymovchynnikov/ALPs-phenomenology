    RowBox[{"(", 
     RowBox[{"ProductionChannels", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
        "\"\<\!\(\*SubscriptBox[\(K\), \(S\)]\)\>\"", "->", "\"\<Ks\>\""}], 
        ",", 
        RowBox[{
        "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \(+\)]\)\>\"", "->", 
         "\"\<RhoCharged\>\""}], ",", 
        RowBox[{"\"\<\[Eta]\>\"", "->", "\"\<Eta\>\""}], ",", 
        RowBox[{"\"\<\[Eta]'\>\"", "->", "\"\<EtaPr\>\""}], ",", 
        RowBox[{"\"\<\[Omega]\>\"", "->", "\"\<Omega\>\""}], ",", 
        RowBox[{
        "\"\<Mixing-\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", "->", 
         "\"\<Mixing-Pi0\>\""}], ",", 
        RowBox[{"\"\<Mixing-\[Eta]\>\"", "->", "\"\<Mixing-Eta\>\""}], ",", 
        RowBox[{"\"\<Mixing-\[Eta]'\>\"", "->", "\"\<Mixing-EtaPr\>\""}]}], 
       "}"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExplanationList", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "\"\<ma [GeV]\>\"", "}"}], ",", "ProductionChannelsCSV"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
