Cell[CellGroupData[{

Cell["\<\
Exporting tabulated angle-energy distributions (currently - fragmentation \
process only)\
\>", "Subsection",
 CellChangeTimes->{{3.9503342985732765`*^9, 
  3.950334314313093*^9}},ExpressionUUID->"d1df24ad-5f00-7e4a-8a73-\
fe1397021fb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"DoubleDistrFragmentationSelected", "[", 
       RowBox[{"mass", ",", "\[Theta]LLP_", ",", "ELLP_"}], "]"}], "=", 
      RowBox[{"DoubleDistrALPfragmentation", "[", 
       RowBox[{
       "modelChoice", ",", "facilityChoice", ",", "mass", ",", 
        "\[CapitalLambda]choice", ",", "\[Theta]LLP", ",", "ELLP"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DoubleDistrFragmentationTabulated", "[", "mass", "]"}], "=", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"mass", ",", "\[Theta]LLP", ",", "ELLP", ",", 
             RowBox[{"DoubleDistrFragmentationSelected", "[", 
              RowBox[{"mass", ",", "\[Theta]LLP", ",", "ELLP"}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Theta]LLP", ",", 
             RowBox[{"\[Theta]Nlist", "[", "facilityChoice", "]"}]}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"ELLP", ",", 
             RowBox[{"ENlist", "[", "facilityChoice", "]"}]}], "}"}]}], "]"}],
          ",", "1"}], "]"}], "//", "Developer`ToPackedArray"}]}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"mass", ",", "MassListFragm"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DoubleDistrTabulated", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", "##", "]"}], "&"}], "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"DoubleDistrFragmentationTabulated", "[", "#", "]"}], "&"}],
          "/@", "MassListFragm"}], ")"}]}], ")"}], "//", "N"}], "//", 
    "Developer`ToPackedArray"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modname", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"modelChoice", "==", "\"\<Gluon\>\""}], ",", "\"\<ALP-gluon\>\"",
      ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"modelChoice", "==", "\"\<Fermion universal\>\""}], ",", 
       "\"\<ALP-fermion\>\"", ",", "modelChoice"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<phenomenology\>\"", 
      ",", "modelChoice", ",", "\"\<spectra\>\"", ",", 
      RowBox[{
      "\"\<DoubleDistr_\>\"", "<>", "modname", "<>", 
       "\"\<_Fragmentation_\>\"", "<>", "facilityChoice", "<>", 
       "\"\<.m\>\""}]}], "}"}], "]"}], ",", "DoubleDistrTabulated", ",", 
   "\"\<MX\>\""}], "]"}]}], "Input",
 CellChangeTimes->{{3.9503379380076237`*^9, 3.950337939034149*^9}},
 CellLabel->
