           "\"\<defining-decay-matrix-elements.nb\>\""}], "}"}], "]"}], "]"}],
        ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "//", 
   "AbsoluteTiming"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Maximal", " ", "order", " ", "of", " ", "\[Delta]", " ", "kept", " ", 
     "the", " ", "final", " ", "expressions", " ", "for", " ", "the", " ", 
     "squared", " ", "matrix", " ", "elements", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"except", " ", "for", " ", "\[Pi]\[Pi]\[Pi]"}], ",", " ", 
       RowBox[{"where", " ", "2", " ", "is", " ", "used"}]}], ")"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]OrderDefault", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Replacement", " ", "rule", " ", "for", " ", "the", " ", "expression"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"symbolsToNumbersWidths", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"ruleSymbolsToNumbersFinal", "[", 
        RowBox[{"expr", ",", "\[Delta]OrderDefault"}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"symbolsToNumbersWidths3\[Pi]", "[", "expr_", "]"}]}], ":=", 
      RowBox[{"ruleSymbolsToNumbersFinal", "[", 
       RowBox[{"expr", ",", "2"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]OrderDefault", "=", "1"}], ";"}], "\[IndentingNewLine]", 
