         RowBox[{"cRGval", "[", 
          RowBox[{
          "modelChoice", ",", "\[CapitalLambda]Choice", ",", "\"\<cG\>\""}], 
          "]"}], ",", "F\[Pi]"}], "]"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"FileNameJoin", "[", 
