        RowBox[{"{", 
         RowBox[{"ma", ",", "3.01", ",", "10.", ",", "mstep2"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"marange", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"marange1", ",", "marange2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalGamma]listTemp", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
