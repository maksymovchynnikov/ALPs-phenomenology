 RowBox[{
  RowBox[{"BlockWidthsTabulation", "[", 
   RowBox[{"Model_", ",", "fa_", ",", "\[CapitalLambda]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
        "Fixing", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
         "low"}], "-", 
        RowBox[{
        "energy", " ", "ALP", " ", "couplings", " ", "by", " ", "their", " ", 
         "values", " ", "at", " ", "the", " ", "scale", " ", "\[Mu]"}]}], " ",
        "=", " ", 
       RowBox[{"2", " ", "GeV"}]}], ",", " ", 
      RowBox[{
      "given", " ", "the", " ", "model", " ", "and", " ", 
       "\[CapitalLambda]"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"crgval", "[", 
         RowBox[{"ALPcouplingslist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "=", 
        RowBox[{"cRGval", "[", 
         RowBox[{"Model", ",", "\[CapitalLambda]", ",", 
          RowBox[{"ALPcouplingslist", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "ALPcouplingslist", "]"}], ",", "1"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rgflow", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"crgval", "[", 
         RowBox[{"ALPcouplingslist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "ALPcouplingslist", "]"}], ",", "1"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"The", " ", 
       SubscriptBox["c", "\[Gamma]\[Gamma]"], " ", "coupling", " ", 
       "smoothly", " ", "glued", " ", "between", " ", "the", " ", "ChPT", " ",
        "regime", " ", "and", " ", "the", " ", "QCD", " ", "perturbative", 
       " ", "regime"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c\[Gamma]glued", "[", "ma_", "]"}], "=", 
      RowBox[{"c\[Gamma]Gluing", "[", 
       RowBox[{"ma", ",", "\[CapitalLambda]", ",", 
        RowBox[{"crgval", "[", "\"\<cu\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<cd\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<cs\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<cc\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<cb\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<ct\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<cG\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<ce\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<c\[Mu]\>\"", "]"}], ",", 
        RowBox[{"crgval", "[", "\"\<c\[Tau]\>\"", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "range", " ", "of", " ", "masses", " ", "for", " ", "which",
        " ", "the", " ", "widths", " ", "tabulation", " ", "will", " ", "be", 
       " ", "performed"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[CapitalDelta]range", "=", "0.002"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mstep1", "=", "0.001"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mstep2", "=", "0.005"}], ";", "\[IndentingNewLine]", 
     RowBox[{"marangetemp", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"ma", ",", 
          RowBox[{"{", 
           RowBox[{"ma", ",", "0.01", ",", "1.2", ",", "mstep1"}], "}"}]}], 
         "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"ma", ",", 
          RowBox[{"{", 
           RowBox[{"ma", ",", "1.205", ",", "3.", ",", "mstep2"}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"marange1", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"marangetemp", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
              "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"",
                "]"}], "-", "\[CapitalDelta]range"}], "<", "#", "<", 
             RowBox[{
              RowBox[{
              "MASS", "[", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"",
                "]"}], "+", "\[CapitalDelta]range"}]}], ")"}]}], "&&", 
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}], "-", 
              "\[CapitalDelta]range"}], "<", "#", "<", 
             RowBox[{
              RowBox[{"MASS", "[", "\"\<\[Eta]\>\"", "]"}], "+", 
