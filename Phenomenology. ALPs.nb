        "modelChoice", ",", "\[CapitalLambda]Choice", ",", "\"\<\[Eta]\>\"", 
         ",", "mLLP", ",", "F\[Pi]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<|\!\(\*SubscriptBox[\(\[Theta]\), \(\[Eta]' \
a\)]\)\!\(\*SuperscriptBox[\(|\), \(2\)]\) (\[Epsilon] = 1)\>\"", ",", 
       RowBox[{"\[Theta]2m0a", "[", 
        RowBox[{
        "modelChoice", ",", "\[CapitalLambda]Choice", ",", "\"\<\[Eta]'\>\"", 
         ",", "mLLP", ",", "F\[Pi]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\!\(\*SubscriptBox[\(g\), \(app\)]\) (\[Epsilon] = 1)\>\"", ",", 
       RowBox[{"gaNNnumeric", "[", 
        RowBox[{"mLLP", ",", 
         RowBox[{"cRGval", "[", 
