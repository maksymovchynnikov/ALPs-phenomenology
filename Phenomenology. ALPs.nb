Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabCouplings", "[", 
    RowBox[{"ma_", ",", "fa_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"gaNNnumeric", "[", 
      RowBox[{"ma", ",", 
       RowBox[{"cRGval", "[", 
        RowBox[{"#", ",", 
         SuperscriptBox["10", "3."], ",", "\"\<cu\>\""}], "]"}], ",", 
