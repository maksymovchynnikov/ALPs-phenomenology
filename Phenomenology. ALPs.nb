Cell[BoxData[{
 RowBox[{"prodred", "=", 
  RowBox[{"Select", "[", 
   RowBox[{"ProductionChannels", ",", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"MemberQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<Mixing\>\"", ",", "\"\<Drell-Yan\>\"", ",", 
          "\"\<Bremsstrahlung\>\"", ",", "\"\<Fragmentation\>\""}], "}"}], 
        ",", "#"}], "]"}]}], "&"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#", ",", 
      RowBox[{"listProcessesMeson", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
   "prodred"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"replacementRuleMesonDecay", "[", 
    RowBox[{"\"\<B\>\"", ",", "\"\<B\>\""}], "]"}], "=", "\"\<B\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"combinations", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"meson", ",", 
           RowBox[{
            RowBox[{"listProcessesMeson", "[", "meson", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"listProcessesMeson", "[", "meson", "]"}], "]"}], ",", 
           "1"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"meson", ",", "prodred"}], "}"}]}], "]"}], ",", "1"}], 
    "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Standard", " ", "tabulated", " ", "format"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prodProbListTemp", "[", "ma_", "]"}], "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "ma", "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mes", "=", 
            RowBox[{
             RowBox[{"combinations", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"proc", "=", 
            RowBox[{
             RowBox[{"combinations", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mes", "!=", "\"\<B\>\""}], ",", 
           RowBox[{"Re", "[", 
            RowBox[{"BrLightMesons", "[", 
             RowBox[{
             "ma", ",", "F\[Pi]", ",", "mes", ",", "proc", ",", "modelChoice",
               ",", "\[CapitalLambda]choice"}], "]"}], "]"}], ",", 
           RowBox[{"BrBtoALP", "[", 
            RowBox[{
            "\"\<Total\>\"", ",", "modelChoice", ",", 
             "\[CapitalLambda]Choice", ",", "ma", ",", "F\[Pi]"}], "]"}]}], 
          "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "combinations", "]"}], ",", "1"}], "}"}]}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"malist", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"ma", ",", 
       RowBox[{"{", 
        RowBox[{"ma", ",", "0.05", ",", "10.", ",", "0.005"}], "}"}]}], "]"}],
      ",", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MASS", "[", "#", "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
            "\"\<\[Eta]\>\"", ",", "\"\<\[Eta]'\>\""}], "}"}]}], ",", "#"}], 
        "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProductionChannelsCSV", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\"\<Br_\>\"", "<>", 
       RowBox[{"replacementRuleMesonDecay", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}], "&"}], "/@", 
    "combinations"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExplanationList", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "\"\<ma [GeV]\>\"", "}"}], ",", "ProductionChannelsCSV"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tabProbabilitiesToExport", "[", "facilityChoice", "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"prodProbListTemp", "[", "ma", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ma", ",", "malist"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<phenomenology\>\"", 
      ",", "modelChoice", ",", "\"\<production\>\"", ",", 
