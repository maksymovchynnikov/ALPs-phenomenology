0132a6930e75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ifExportingSensCalc", "=", "False"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{"ifExportingSensCalc", ",", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Br", " ", "ratios", " ", "in", " ", "terms", " ", "of", " ", "the", " ", 
     "ALP", " ", "mass"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gr2", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<2e\>\"", ",", "\"\<2\[Mu]\>\"", ",", "\"\<2\[Tau]\>\"", ",", 
         "\"\<2\[Gamma]\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(-\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Gamma]\[Pi]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(-\)]\)2\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
         "\"\<2\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)2\!\(\*SuperscriptBox[\
\(\[Pi]\), \(-\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Eta]2\[Pi]\), \(0\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Eta]\[Pi]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(K\), \
\(*\(+\)\)]\)\!\(\*SuperscriptBox[\(K\), \(*\(-\)\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(K\), \
\(*\(0\)\)]\)\!\(\*SuperscriptBox[OverscriptBox[\(K\), \(_\)], \
\(*\(0\)\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Omega]\[Pi]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\"", ",", 
         "\"\<3\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
         "\"\<\[Eta]'2\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
         "\"\<\[Eta]'\!\(\*SuperscriptBox[\(\[Pi]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\"", ",", 
         "\"\<2\[Omega]\>\"", ",", "\"\<2G\>\"", ",", "\"\<2c\>\"", ",", 
         "\"\<2s\>\""}], "}"}], ",", "proclistKK\[Pi]", ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<2\!\(\*SuperscriptBox[\(\[Rho]\), \(0\)]\)\>\"", ",", 
         "\"\<\!\(\*SuperscriptBox[\(\[Rho]\), \
\(+\)]\)\!\(\*SuperscriptBox[\(\[Rho]\), \(-\)]\)\>\""}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"mmaxproc", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<2e\>\"", ",", "\"\<2\[Mu]\>\"", ",", "\"\<2\[Tau]\>\"", 
               ",", "\"\<2\[Gamma]\>\"", ",", "\"\<2G\>\"", ",", "\"\<2c\>\"",
                ",", "\"\<2s\>\""}], "}"}], ",", "proc"}], "]"}], "==", 
           "False"}], ",", "maMatch", ",", "99999"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mminproc", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<2G\>\"", ",", "\"\<2s\>\""}], "}"}], ",", "proc"}],
             "]"}], "==", "True"}], ",", "maMatch", ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"BrRatioExport", "[", 
         RowBox[{"proc", ",", "ma_"}], "]"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"mminproc", "<=", "ma", "<", "mmaxproc"}], ",", 
          RowBox[{"Evaluate", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"SelectedModelWidths", "[", "proc", "]"}], ",", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", 
             "]"}], 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"SelectedModelWidths", "[", "\"\<Total\>\"", "]"}], 
               ",", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "ma", 
             "]"}]], "]"}], ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]",
       ",", 
      RowBox[{"{", 
       RowBox[{"proc", ",", "gr2"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"partlist2Temp", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"particleslist", "[", "proc", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"proc", ",", "gr2"}], "}"}]}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<e\>\"", ",", "\"\<e\>\""}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SuperscriptBox[\(e\), \(+\)]\)\>\"", ",", 
           "\"\<\!\(\*SuperscriptBox[\(e\), \(-\)]\)\>\""}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<\[Mu]\>\"", ",", "\"\<\[Mu]\>\""}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SuperscriptBox[\(\[Mu]\), \(+\)]\)\>\"", ",", 
           "\"\<\!\(\*SuperscriptBox[\(\[Mu]\), \(-\)]\)\>\""}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<\[Tau]\>\"", ",", "\"\<\[Tau]\>\""}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SuperscriptBox[\(\[Tau]\), \(+\)]\)\>\"", ",", 
