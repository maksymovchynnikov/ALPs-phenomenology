Cell[CellGroupData[{

Cell["Branching ratios", "Subsubsection",
 CellChangeTimes->{{3.950608080925066*^9, 
  3.9506081006441727`*^9}},ExpressionUUID->"ed49eb31-e585-3942-848f-\
e72fbf9da89e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TableForExportSensCalc", "[", 
    RowBox[{"ma_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mes", "=", 
          RowBox[{
           RowBox[{"combinations", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"proc", "=", 
          RowBox[{
           RowBox[{"combinations", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"procrepl", "=", 
          RowBox[{"replacementRuleMesonDecay", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"combinations", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"combinations", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"procrepl", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"mes", "!=", "\"\<B\>\""}], ",", 
           RowBox[{"Re", "[", 
            RowBox[{"BrLightMesons", "[", 
             RowBox[{
             "ma", ",", "F\[Pi]", ",", "mes", ",", "proc", ",", "modelChoice",
               ",", "\[CapitalLambda]choice"}], "]"}], "]"}], ",", 
           RowBox[{"BrBtoALP", "[", 
            RowBox[{
            "\"\<Total\>\"", ",", "modelChoice", ",", 
             "\[CapitalLambda]Choice", ",", "ma", ",", "F\[Pi]"}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"procs3body", ",", 
             RowBox[{"combinations", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"M2numeric", "[", 
            RowBox[{
            "modelChoice", ",", "procrepl", ",", "ma", ",", 
             "\[CapitalLambda]Choice", ",", "E1", ",", "E3"}], "]"}], ",", 
           "0."}], "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "combinations", "]"}], ",", "1"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableForExportSensCalc", "[", 
    RowBox[{"ma_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"TableForExportSensCalc", "[", 
      RowBox[{"ma", ",", "E1", ",", "E3"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Bplus-to-Kplus\>\"", ",", 
         RowBox[{"BrBtoALP", "[", 
          RowBox[{
          "\"\<\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\"", ",", "modelChoice", 
           ",", "\[CapitalLambda]Choice", ",", "ma", ",", "F\[Pi]"}], "]"}], 
         ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<B0-to-Kstar\>\"", ",", 
         RowBox[{"BrBtoALP", "[", 
          RowBox[{
          "\"\<\!\(\*SuperscriptBox[\(K\), \(*\)]\)(892)\>\"", ",", 
           "modelChoice", ",", "\[CapitalLambda]Choice", ",", "ma", ",", 
           "F\[Pi]"}], "]"}], ",", "0."}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"modelrepl", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"modelChoice", "==", "\"\<Fermion universal\>\""}], ",", 
    "\"\<ALP-fermion\>\"", ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"modelChoice", "==", "\"\<Gluon\>\""}], ",", 
      "\"\<ALP-gluon\>\"", ",", "modelChoice"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<phenomenology\>\"", 
      ",", "modelChoice", ",", "\"\<For SensCalc\>\"", ",", 
      RowBox[{
      "\"\<BrRatios-Msquared-LightMesonDecays-\>\"", "<>", "modelrepl", "<>", 
       "\"\<-Lambda=\>\"", "<>", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            SuperscriptBox["10", 
             RowBox[{"-", "3"}]], "\[CapitalLambda]choice"}], "]"}], "//", 
          "CForm"}], "//", "ToString"}], ")"}], "<>", "\"\<-TeV.mx\>\""}]}], 
     "}"}], "]"}], ",", 
   RowBox[{"TableForExportSensCalc", "[", 
    RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], ",", "\"\<MX\>\""}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9506084138706455`*^9, 3.9506084510280037`*^9}, {
   3.9506084857812347`*^9, 3.950608579470028*^9}, 3.9506086791752796`*^9, 
   3.950608848240364*^9, {3.9506089259828815`*^9, 3.950608955323509*^9}, {
