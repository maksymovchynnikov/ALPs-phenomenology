                         "dataKstar"}]}], "]"}], ",", RowBox[{"InterpolationOrder", "\[Rule]",
                     "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
           RowBox[{RowBox[{"KstarBRInter", "[", RowBox[{"m_", ",", "\[Tau]_"}], "]"}], ":=",
